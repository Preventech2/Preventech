@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Preventech.Core.Models
@using Preventech.Core.Services

@rendermode InteractiveServer

@inject UserClaimsHelper UserClaimsHelper

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <AuthorizeView>
            <Authorized>
                <a class="navbar-brand" href="">@FormatName(userInfo?.Name)</a>
            </Authorized>
            <NotAuthorized>
                <a class="navbar-brand" href="">Usuario</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item pad-x">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
    </nav>
    
    <AuthorizeView>
        <Authorized>
            @* Adicione aqui os links que o usuário autenticado pode ver. *@
            <div class="nav-item pad-x">
                <NavLink class="nav-link" href="@url">
                    <span class="bi bi-briefcase-fill" aria-hidden="true"></span> Minhas OSs
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@PerfilExtension.Admin">
        <Authorized>
            @* Adicione aqui os links que o usuário com papel Admin pode ver. *@
            <nav class="nav flex-column">
                <div class="nav-item pad-x">
                    <NavLink class="nav-link" href="/admin/painel" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Admin
                    </NavLink>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private UserInfo? userInfo;
    private string url = "/ordens-servico/user";

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private string FormatName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "Usuario";
        string[]? parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts[0] + ' ' + (parts.Length > 1 ? parts[^1] : "");
    }

    protected override async Task OnInitializedAsync()
    {
        userInfo = await UserClaimsHelper.GetCurrentUserInfoAsync();
    }
}
