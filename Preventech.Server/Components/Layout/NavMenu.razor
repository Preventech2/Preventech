@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Preventech.Core.Models
@using Preventech.Core.Services
@using Preventech.Server.Components.Modals
@rendermode InteractiveServer

@inject UserClaimsHelper UserClaimsHelper
@inject IJSRuntime jsr
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <AuthorizeView>
            <Authorized>
                <a class="navbar-brand" href="">@FormatName(userInfo?.Name)</a>
            </Authorized>
            <NotAuthorized>
                <a class="navbar-brand" href="">Usuario</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<br>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item pad-x">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
    </nav>
    <AuthorizeView>
        <Authorized>
            @foreach (var item in userInfo.Roles)
            {
                <p>@item</p>
            }
            @* Adicione aqui os links que o usuário autenticado pode ver. *@
            <div class="nav-item pad-x">
                <NavLink class="nav-link" href="/admin/painel">
                    <span class="bi bi-briefcase-fill" aria-hidden="true"></span> Admin
                </NavLink>
            </div>
            @if (userInfo != null && userInfo.HasRole("VisualizarOrdemServico"))
            {
                <div class="nav-item pad-x">
                    <NavLink class="nav-link" href="/ordens-servico/user">
                        <span class="bi bi-briefcase-fill" aria-hidden="true"></span> Minhas OSs
                    </NavLink>
                </div>
            }
            @if (userInfo != null && userInfo.HasRole("VisualizarLaboratorio"))
            {
                <div class="nav-item pad-x">
                    <button class="nav-link" @onclick="@(_ => AtivarModal(1))">Cadastrar Localização</button>
                </div>
                <div class="nav-item pad-x">
                    <button class="nav-link" @onclick="@(_ => AtivarModal(2))">Editar Localização</button>
                </div>
            }
            @if (userInfo != null && userInfo.HasRole("EditarEquipamento"))
            {
                <div class="nav-item pad-x">
                    <button class="nav-link" @onclick="@(_ => AtivarModal(3))">Cadastrar Equipamento</button>
                </div>
            }
        </Authorized>
    </AuthorizeView>
</div>
<div id="nav-modais">
    <Preventech.Server.Components.Modals.Localizacoes.Cadastrar Aberto="@(modal == 1)" Resetar=@resetar/>
    <Preventech.Server.Components.Modals.Localizacoes.Editar    Aberto="@(modal == 2)" Resetar=@resetar/>
    <Preventech.Server.Components.Modals.Equipamento.Cadastrar  Aberto="@(modal == 3)" Resetar=@resetar/>
</div>
@code {

    private async Task resetar() => modal = 0;
    private int modal = 0;
    private UserInfo? userInfo;
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected async Task AtivarModal(int num) {
        modal = num;
        StateHasChanged();
    }
    private string FormatName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "Usuario";
        string[]? parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts[0] + ' ' + (parts.Length > 1 ? parts[^1] : "");
    }
    protected async Task AtivarModal(int num) {

        jsr.InvokeVoidAsync("console.log", num);
        modal = num;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        userInfo = await UserClaimsHelper.GetCurrentUserInfoAsync();
    }

}
