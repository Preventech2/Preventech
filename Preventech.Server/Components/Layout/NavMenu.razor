@rendermode InteractiveServer

@inject AuthenticationStateService authStateService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
    @if(!string.IsNullOrEmpty(NomeUsuario)) {
        <a class="navbar-brand" href="">@NomeUsuario</a>
    } else {
        <a class="navbar-brand" href="">Convidado</a>
    }
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
    </nav>
    <AuthorizeView>
        <Authorized>
            @* Adicione aqui os links que o usuário autenticado pode ver. *@
            @if (usuario != null)
            
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@url">
                       <span class="bi bi-briefcase-fill" aria-hidden="true"></span> Minhas OSs
                    </NavLink>
                </div>
            }
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private string? NomeUsuario = null;
    private Usuario? usuario = null;

    private string url = "/ordens-servico/user/";

    protected override async Task OnInitializedAsync()
    {
        usuario = await authStateService.GetUsuarioAsync();
        url += usuario?.Id.ToString();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender)
        {        
            NomeUsuario = usuario?.Nome;
            StateHasChanged();
        }
    }
}
