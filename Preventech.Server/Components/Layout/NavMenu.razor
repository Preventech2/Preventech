@using Preventech.Server.Provider
@rendermode InteractiveServer

@inject CustomAuthStateProvider authStateService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@NomeUsuario</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
    </nav>
    <AuthorizeView>
        <Authorized>
            @* Adicione aqui os links que o usuário autenticado pode ver. *@
            @if (usuario != null)
            
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@url">
                       <span class="bi bi-briefcase-fill" aria-hidden="true"></span> Minhas OSs
                    </NavLink>
                </div>
            }
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private string? NomeUsuario = null;
    private Usuario? usuario = null;

    private string url = "/ordens-servico/user/";

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        usuario = await authStateService.GetUsuarioAsync();
        url += usuario?.Id.ToString();
        var authState = await AuthenticationStateTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // Tenta pegar a claim padrão do nome
            NomeUsuario = user.Identity.Name 
                ?? user.Claims.FirstOrDefault(c => c.Type == "name")?.Value;
        }
    }
}
