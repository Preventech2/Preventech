@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Preventech.Core.Models

@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <AuthorizeView>
            <Authorized>
                <a class="navbar-brand" href="">@nomeUsuario</a>
            </Authorized>
            <NotAuthorized>
                <a class="navbar-brand" href="">Usuario</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
    </nav>
    <AuthorizeView>
        <Authorized>
            @* Adicione aqui os links que o usuário autenticado pode ver. *@
            @if (usuario != null)
            
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@url">
                       <span class="bi bi-briefcase-fill" aria-hidden="true"></span> Minhas OSs
                    </NavLink>
                </div>
            }
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private Usuario? usuario = null;
    private string nomeUsuario = "Usuário";
    private string url = "/ordens-servico/user/";

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // Get the name from ClaimTypes.Name (set in AuthController)
            nomeUsuario = user.Identity.Name 
                ?? user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value
                ?? "Usuário";
                
            // You can also get other claims if needed:
            // var cpf = user.Claims.FirstOrDefault(c => c.Type == "Cpf")?.Value;
            // var roles = user.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value).ToList();
        }
        else
        {
            nomeUsuario = "Usuário";
        }
    }
}
