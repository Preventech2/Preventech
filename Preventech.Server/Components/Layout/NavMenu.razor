@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Preventech.Core.Models
@using Preventech.Core.Services
@using Preventech.Server.Components.Modals
@rendermode InteractiveServer

@inject UserClaimsHelper UserClaimsHelper
@inject IJSRuntime jsr
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <AuthorizeView>
            <Authorized>
                <a class="navbar-brand" href="meu-perfil">@userInfo?.DisplayName()</a>
            </Authorized>
            <NotAuthorized>
                <a class="navbar-brand" href="">Usuario</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<br>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item pad-x">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
    </nav>
    
    <AuthorizeView>
        <Authorized>
            @* Adicione aqui os links que o usuário autenticado pode ver. *@
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@PerfilExtension.Admin">
        <Authorized>
            @* Adicione aqui os links que o usuário com papel Admin pode ver. *@
            <nav class="nav flex-column">
                <div class="nav-item pad-x">
                    <NavLink class="nav-link" href="/admin/painel" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Admin
                    </NavLink>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@PerfilExtension.VisualizarOrdemDeServico">
        <Authorized>
            <nav class="nav flex-column">
                <div class="nav-item pad-x">
                    <NavLink class="nav-link" href="/ordens-servico/user">
                        <span class="bi bi-briefcase-fill" aria-hidden="true"></span> Minhas OSs
                    </NavLink>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@PerfilExtension.VisualizarOrdemDeServico">
        <Authorized>
            <nav class="nav flex-column">
                <div class="nav-item pad-x">
                    <button class="nav-link" @onclick="@(_ => AtivarModal(1))">Cadastrar Localização</button>
                </div>
            </nav>
            <nav class="nav flex-column">
                <div class="nav-item pad-x">
                    <button class="nav-link" @onclick="@(_ => AtivarModal(2))">Editar Localização</button>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@PerfilExtension.VisualizarOrdemDeServico">
        <Authorized>
            <nav class="nav flex-column">
                <div class="nav-item pad-x">
                    <button class="nav-link" @onclick="@(_ => AtivarModal(3))">Cadastrar Equipamento</button>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>
</div>
<footer>Powered by Preventech</footer>

<div id="nav-modais">
    <Preventech.Server.Components.Modals.Localizacoes.Cadastrar Aberto="@(modal == 1)" Resetar=@resetar/>
    <Preventech.Server.Components.Modals.Localizacoes.Editar    Aberto="@(modal == 2)" Resetar=@resetar/>
    <Preventech.Server.Components.Modals.Equipamento.Cadastrar  Aberto="@(modal == 3)" Resetar=@resetar/>
</div>

@code {

    private async Task resetar() => modal = 0;
    private int modal = 0;
    private UserInfo? userInfo;
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected async Task AtivarModal(int num) {
        modal = num;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        userInfo = await UserClaimsHelper.GetCurrentUserInfoAsync();
    }

}