@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Preventech.Core.Models
@using Preventech.Core.Services
@using Preventech.Server.Components.Modals

@rendermode InteractiveServer

@inject UserClaimsHelper UserClaimsHelper
@inject MenuStateService MenuStateService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="navmenu-top">
        <button class="btn-icon btn-navbar-toggler" @onclick="ToggleMenu"><img class="icon" src="img/menu-btn.svg" alt="" /></button>
        <AuthorizeView>
            <Authorized>
                @* trocar para pegar a foto de perfil do usuário *@
                <div class="profile-picture-container"><img src="img/default-profile-picture.svg" alt="" class="profile-picture" /></div>
                <a class="navbar-brand" href="meu-perfil">@userInfo.DisplayName()</a>
            </Authorized>
            <NotAuthorized>
                <div class="profile-picture-container"><img src="img/default-profile-picture.svg" alt="" class="profile-picture" /></div>
                <a class="navbar-brand" href="">Usuario</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<input type="checkbox" checked="@IsMenuOpen" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column no-select">
        <div class="nav-item pad-x">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
    </nav>
    
    <AuthorizeView>
        <Authorized>
            @* Adicione aqui os links que o usuário autenticado pode ver. *@
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@PerfilExtension.Admin">
        <Authorized>
            @* Adicione aqui os links que o usuário com papel Admin pode ver. *@
            <nav class="nav flex-column no-select">
                <div class="nav-item pad-x">
                    <NavLink class="nav-link" href="/admin/painel" Match="NavLinkMatch.All">
                        <span class="bi bi-admin-fill-nav-menu" aria-hidden="true"></span> Admin
                    </NavLink>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@PerfilExtension.VisualizarEquipamento">
        <Authorized>
            <nav class="nav flex-column no-select">
                <div class="nav-item pad-x">
                    <NavLink class="nav-link" href="/equipamentos">
                        <span class="bi bi-equipamentos-fill-nav-menu" aria-hidden="true"></span> Equipamentos
                    </NavLink>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@PerfilExtension.VisualizarLaboratorio">
        <Authorized>
            <nav class="nav flex-column no-select">
                <div class="nav-item pad-x">
                    <NavLink class="nav-link" href="/laboratorios">
                        <span class="bi bi-labs-fill-nav-menu" aria-hidden="true"></span> Laboratórios
                    </NavLink>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@PerfilExtension.VisualizarOrdemDeServico">
        <Authorized>
            <nav class="nav flex-column no-select">
                <div class="nav-item pad-x">
                    <NavLink class="nav-link" href="/ordens-servico">
                        <span class="bi bi-manutencao-fill-nav-menu" aria-hidden="true"></span> Manutenções
                    </NavLink>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@PerfilExtension.GerenciarEstoque">
        <Authorized>
            <nav class="nav flex-column no-select">
                <div class="nav-item pad-x">
                    <NavLink class="nav-link" href="/estoque">
                        <span class="bi bi-estoque-fill-nav-menu" aria-hidden="true"></span> Estoque
                    </NavLink>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>
</div>

<footer><p class="no-select">Powered by Preventech</p></footer>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private UserInfo userInfo = new UserInfo();

    public bool IsMenuOpen { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        userInfo = await UserClaimsHelper.GetCurrentUserInfoAsync();
    }

    private void ToggleMenu()
    {
        IsMenuOpen = !IsMenuOpen;
        MenuStateService.NotifyMenuToggled();
    }

}