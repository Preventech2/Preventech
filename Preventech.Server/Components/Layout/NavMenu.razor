@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Preventech.Core.Models
@using Preventech.Core.Services

@rendermode InteractiveServer

@inject UserClaimsHelper UserClaimsHelper

<div class="top-row ps-3 navbar navbar-dark">
    <AuthorizeView>
        <Authorized>
            <a class="navbar-brand" href="">@userInfo?.Name</a>
        </Authorized>
        <NotAuthorized>
            <a class="navbar-brand" href="">Usuario</a>
        </NotAuthorized>
    </AuthorizeView>
</div>

<br>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item pad-x">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
    </nav>
    <AuthorizeView>
        <Authorized>
            @* Adicione aqui os links que o usuário autenticado pode ver. *@
            @if (userInfo != null && userInfo.HasRole("VisualizarOrdemServico"))

            {
                <div class="nav-item pad-x">
                    <NavLink class="nav-link" href="/ordens-servico/user">
                        <span class="bi bi-briefcase-fill" aria-hidden="true"></span> Minhas OSs
                    </NavLink>
                </div>
            }
            @if (userInfo != null && userInfo.HasRole("VisualizarLocalizacao"))
            {
                <div class="nav-item pad-x">
                    <NavLink class="nav-link" href="/localizacao/cadastrar">
                    <span class="bi bi-briefcase-fill" aria-hidden="true"></span>Cadastrar Localização
                    </NavLink>
                </div>
                <div class="nav-item pad-x">
                    <NavLink class="nav-link" href="/localizacao/editar">
                    <span class="bi bi-briefcase-fill" aria-hidden="true"></span>Editar Localização
                    </NavLink>
                </div>
            }
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private UserInfo? userInfo;
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        userInfo = await UserClaimsHelper.GetCurrentUserInfoAsync();
    }
}
