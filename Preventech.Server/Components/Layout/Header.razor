@rendermode InteractiveServer
@inject Preventech.Core.Services.HeaderService HeaderService
@implements IDisposable

<section class="no-select">
    @* Título superior do site *@
    @* Basta utilizar o componente HeaderTitle para mudar o título *@
    <header>
        <h4>@HeaderService.Title</h4>
    </header>

    @* Menu de opções, como Login/Logout *@
    <menu>
        <AuthorizeView>
            <Authorized>
                <NotificacaoIcone />
                <a href="/logout">Logout</a>
            </Authorized>
            <NotAuthorized>
                <a href="/login">Login</a>
            </NotAuthorized>
        </AuthorizeView>
    </menu>
</section>

@code {
    protected override void OnInitialized()
    {
        HeaderService.TitleChanged += OnTitleChanged;
    }

    private void OnTitleChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        HeaderService.TitleChanged -= OnTitleChanged;
    }
}