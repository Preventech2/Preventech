@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
        <footer>Powered by Preventech</footer>
    </div>

    <main>
        <div class="top-row pad-x">
            <Header />
        </div>

        <article class="content pad-x">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>