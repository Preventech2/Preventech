<EditForm class="modal" style="@(Aberto ? "" : "display: none;")" Model="equipamento" FormName="cadastrar-Equipamento">
    <button class="fecha-form" @onclick="Recarregar">x</button>

    <label>Nome:</label>
    <InputText @bind-Value="equipamento!.Nome" class="form-control" />
    <label>Patrimônio:</label>
    <InputText @bind-Value="equipamento!.Patrimonio" class="form-control" />
    @if (locais != null && locais.Any())
    {
        <div class="mb-3">
            <label>Localização:</label>
            <InputSelect @bind-Value="localid">
                @foreach (var local in locais)
                {
                    <option value="@local!.Id">@local.ToString()</option>
                }
            </InputSelect>
            <span>Não encontrou o local? <a href="/cadastrar/localizacao">Cadastre-o!</a></span>
        </div>
    }
    else
    {
        <p><em>Carregando locais</em></p>
    }
    <button type="submit" @onclick="FormData" class="btn btn-primary" disabled="@isProcessing" autofocus>
        @if (isProcessing)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <text>Cadastrando...</text>
        }
        else
        {
            <text>Cadastrar</text>
        }
    </button>
</EditForm>

@code {
    [Parameter] 
    public EventCallback Resetar { get; set; }

    [Parameter]
    public bool Aberto { get; set; } = false;

    [SupplyParameterFromForm]
    private Equipamento? equipamento { get; set; } = null;

    [Inject]
    EquipamentoService equipamentoService { get; set; } = null!;

    [Inject]
    LocalizacaoService localizacaoService { get; set; } = null!;

    private IQueryable<Localizacao> locais = null!;

    private int localid;
    private string mensagemResultado = string.Empty;
    private bool sucesso = false;
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        equipamento ??= new Equipamento();
        var res = await localizacaoService.GetLocalizacoes(new Localizacao());
        sucesso = res.Success;
        mensagemResultado = res.Message;
        if (res.Data != null)
            locais = res.Data.AsQueryable();
    }

    private async Task FormData()
    {
        isProcessing = true;
        mensagemResultado = string.Empty;
        StateHasChanged();
        equipamento!.Local = locais.Where(l => l.Id == localid).First();
        try
        {
            // tem que mudar, atualmente o equipamentoService apenas chama a API e ela só retorna um sucesso
            // testando API

            var resultado = await equipamentoService.AddEquipamentoAsync(equipamento!);

            if (resultado != null && resultado.Success)
            {
                mensagemResultado = resultado.Message;
                sucesso = true;
            }
            else
            {
                mensagemResultado = "Erro inesperado ao cadastrar o equipamento.";
                sucesso = false;
            }
        }
        catch (Exception ex)
        {
            mensagemResultado = $"Erro: {ex.Message}";
            sucesso = false;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task Recarregar(EventArgs ev) {
        Aberto = false;
        Resetar.InvokeAsync();
    }
}