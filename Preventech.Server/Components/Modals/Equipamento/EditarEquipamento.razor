@namespace Preventech.Server.Components.Modals
@rendermode InteractiveServer

@inject LocalizacaoService localizacaoService
@inject EquipamentoService equipamentoService

<Modal IsActive="IsActive" IsActiveChanged="@OnIsActiveChanged">
    <MostrarMensagem @bind-Mensagem="mensagem" />

    <EditForm class="edit-form" Model="equipamento" FormName="cadastrar-Equipamento">
        <label>Nome:</label>
        <InputText @bind-Value="equipamento!.Nome" class="form-control" />
        <label>Patrimônio:</label>
        <InputText @bind-Value="equipamento!.Patrimonio" class="form-control" />
        @if (localizacoes != null && localizacoes.Any())
        {
            <div class="mb-3">
                <label>Localização:</label>
                <InputSelect @bind-Value="@equipamento.Local.Id" class="form-control">
                    <option value="0">Selecionar local</option>
                    @foreach (var local in localizacoes)
                    {
                        <option value="@local.Id">@local.ToString()</option>
                    }
                </InputSelect>
            </div>
        }
        else
        {
            <p><em>Carregando locais</em></p>
        }
        <button type="submit" @onclick="EditarEquip" class="btn btn-primary" disabled="@isProcessing" autofocus>
            @if (isProcessing)
            {
                <text>Editando...</text>
            }
            else
            {
                <text>Editar</text>
            }
        </button>
    </EditForm>
</Modal>

@code {
    [Parameter]
    public bool IsActive { get; set; } = false;

    [Parameter]
    public EventCallback<bool> IsActiveChanged { get; set; }

    [Parameter]
    public Equipamento equipamento { get; set; } = Equipamento.Vazio;

    [Parameter]
    public EventCallback<Equipamento> equipamentoChanged { get; set; }

    /// Lista de equipamentos
    List<Equipamento> equipamentos = new();

    /// lista de localizações
    List<Localizacao> localizacoes = new();

    bool isProcessing = false;
    public string mensagem = string.Empty;

    protected override async Task OnInitializedAsync() => await InitializeEquipamento();

    private async Task InitializeEquipamento()
    {
        equipamento = Equipamento.Vazio;
        var res = await equipamentoService.GetEquipamentos(Equipamento.Vazio);
        var resloc = await localizacaoService.GetLocalizacoes(Localizacao.Vazia, DateTime.MinValue);

        mensagem = !res.Success ? res.Message : !resloc.Success ? resloc.Message : string.Empty;

        equipamentos = res.Data ?? new();
        localizacoes = resloc.Data!.Select(x => LocalizacaoExtension.Descompactar(x, Localizacao.Vazia)).ToList() ?? new ();
    }

    private async Task EditarEquip()
    {
        isProcessing = true;
        mensagem = string.Empty;
        StateHasChanged();
        try
        {
            var res = await equipamentoService.UpdateEquipamentoAsync(equipamento);
            if (res is null)
                mensagem = "sem resposta";
            else if (!res.Success)
                mensagem = res.Message;
            else
                equipamento = Equipamento.Vazio;
        }
        catch (Exception ex)
        {
            mensagem = $"Erro: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
            IsActive = false;
        }
    }

    // Informa ao componente pai a mudança do estado do Modal
    private async Task OnIsActiveChanged(bool isActive)
    {
        await InitializeEquipamento();
        IsActive = isActive;
        await IsActiveChanged.InvokeAsync(IsActive);
    }
}