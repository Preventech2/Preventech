<EditForm class="modal" style="@(Aberto ? "" : "display: none;")" Model="local" FormName="cadastrar-Localizacoes">
    <button class="fecha-form" @onclick="Recarregar">x</button>
    <h2>Cadastrar locald1ização</h2>
    <br>
    <p><em>*</em> indica item obrigatório</p>
    <div>
        <label data-tooltip="Nome dado à um local, caso aplicável. Exemplos: 'LABFUND' ou 'DGO'">Nome:</label>
        <InputText @bind-Value="local!.Apelido" class="form-control" />
    </div>
    <div>
        <label data-tooltip="Número do campus que esta localização se refere"><em>*</em>Campus:</label>
        <InputNumber @bind-Value="local!.Campus" class="form-control" required />
    </div>
    <div>
        <label data-tooltip="Número do prédio desta localização"><em>*</em>Prédio:</label>
        <InputNumber @bind-Value="local!.Predio" class="form-control" required />
    </div>
    <div>
        <label data-tooltip="Número do andar desta localização"><em>*</em>Andar:</label>
        <InputNumber @bind-Value="local!.Andar" class="form-control" required />
    </div>
    <div>
        <label data-tooltip="Número da sala"><em>*</em>Sala:</label>
        <InputNumber @bind-Value="local!.Numero" class="form-control" required />
    </div>
    <div>
        <label>Técnicos</label>
        <InputSelect list="tecnicos" @bind-Value="idResponsavel" class="form-control" required>
            @if (tecnicos != null && tecnicos.Any())
            {
                @foreach (var tecnico in tecnicos)
                {
                    <option value="tecnico.Id">@tecnico.Nome</option>
                }
            }
            else
            {
                <p><em>Técnicos não encontrados!</em></p>
            }
        </InputSelect>
    </div>
    <button @onclick="SubmitLoc" class="btn btn-primary" disabled="@isProcessing" autofocus>
        @if (isProcessing)
        {
            <text>Cadastrando...</text>
        }
        else
        {
            <text>Cadastrar</text>
        }
    </button>
</EditForm>

@code {
    [Parameter] 
    public EventCallback Resetar { get; set; }

    [Parameter]
    public bool Aberto { get; set; } = false;

    [SupplyParameterFromForm]
    private Localizacao? local { get; set; } = new Localizacao();
    private int idResponsavel { get; set; } = 0;
    [Inject]
    LocalizacaoService localizacaoService { get; set; } = null!;
    [Inject]
    UsuarioService usuarioService { get; set; } = null!;
    private string mensagemResultado = string.Empty;
    private IEnumerable<Usuario> tecnicos = new List<Usuario>();
    private bool sucesso = false;
    private bool isProcessing = false;
    protected override async Task OnInitializedAsync()
    {
        var restec = await usuarioService.GetUsuariosAsync();
        sucesso = restec != null && restec.Success;
        if (!sucesso)
        {
            mensagemResultado = $"Erro inesperado ao resgatar técnicos: {(restec == null ? "" : restec.Message)} : .";
            return;
        }
        tecnicos = from tecnico in restec!.Data
                   where tecnico.Perfil != null && tecnico.Perfil! != 0
                   select tecnico;

        return;
    }

    private async Task SubmitLoc()
    {
        isProcessing = true;
        mensagemResultado = string.Empty;
        StateHasChanged();
        try
        {
            local.Responsavel = tecnicos
            .Where(x => x.Id == idResponsavel)
            .First();
            var resultado = await localizacaoService.AddLocalizacaoAsync(local!);

            sucesso = resultado != null && resultado.Success;
            mensagemResultado = sucesso
            ? resultado.Message
            : $"Erro inesperado ao cadastrar localização: {resultado.Message}";

        }
        catch (Exception ex)
        {
            mensagemResultado = $"Erro: {ex.Message}";
            sucesso = false;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }

        return;
    }

    private async Task Recarregar(EventArgs ev) {
        Aberto = false;
        Resetar.InvokeAsync();
    }
}