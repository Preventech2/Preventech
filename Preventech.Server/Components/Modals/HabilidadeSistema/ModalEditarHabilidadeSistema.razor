@namespace Preventech.Server.Components.Modals

@rendermode InteractiveServer

@inject HabilidadeSistemaService HabilidadeSistemaService

<Modal @bind-IsActive="IsActive">
    <MostrarMensagem @bind-Mensagem="mensagem" />
    <h3>Editar Habilidade do Sistema</h3>
    <EditForm Model="@novaHabilidade" OnValidSubmit="@EditarHabilidadeSistema">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="nome">Nome Antigo</label>
            <InputText id="nome" class="form-control" @bind-Value="@NomeAntigo" disabled="true" />
        </div>

        <div class="form-group">
            <label for="nome">Novo Nome</label>
            <InputText id="nome" class="form-control" @bind-Value="@novaHabilidade.Nome" />
            <ValidationMessage For="@(() => novaHabilidade.Nome)" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@IsProcessing">Editar</button>
    </EditForm>

    <section class="info-section">
        <p>Essas habilidades do sistema definem quais possíveis habilidades os usuários podem ter.</p>
        <p>Adicione com base nas necessidades das manutenções.</p>
    </section>
</Modal>

@code {
    [Parameter]
    public bool IsActive { get; set; }

    [Parameter]
    public EventCallback OnHabilidadeEditada { get; set; }

    [Parameter]
    public int HabilidadeId { get; set; }

    [Parameter]
    public EventCallback<int> HabilidadeIdChanged { get; set; }

    public string NomeAntigo { get; set; } = string.Empty;

    private HabilidadeSistema novaHabilidade = new HabilidadeSistema();

    public string mensagem = string.Empty;
    private bool IsProcessing { get; set; } = false;

    // Variáveis para controlar mudanças
    private bool _previousIsActive = false;
    private int _previousHabilidadeId = 0;

    private async Task EditarHabilidadeSistema()
    {
        IsProcessing = true;
        ApiResponse<HabilidadeSistema> response = await HabilidadeSistemaService.EditHabilidadeSistemaAsync(novaHabilidade);
        if (response.Success)
        {
            mensagem = "Habilidade editada com sucesso!";
            novaHabilidade = new HabilidadeSistema(); // Reset form
            await OnHabilidadeEditada.InvokeAsync(null);
        }
        else
        {
            mensagem = response.Message;
            novaHabilidade = new HabilidadeSistema(); // Reset form
        }
        IsProcessing = false;
    }

    private async Task CarregarHabilidade()
    {
        if (HabilidadeId > 0)
        {
            mensagem = string.Empty; // Limpa mensagens anteriores
            ApiResponse<HabilidadeSistema> response = await HabilidadeSistemaService.GetHabilidadeByIdAsync(HabilidadeId);
            if (response.Success && response.Data != null)
            {
                novaHabilidade = response.Data;
                NomeAntigo = novaHabilidade.Nome ?? string.Empty;
                Console.WriteLine("Habilidade carregada para edição: " + NomeAntigo);
            }
            else
            {
                mensagem = response.Message;
            }
            StateHasChanged(); // Força a atualização da UI
        }
        else
        {
            // Se não há ID, reseta o form
            novaHabilidade = new HabilidadeSistema();
            NomeAntigo = string.Empty;
            mensagem = string.Empty;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CarregarHabilidade();
        _previousIsActive = IsActive;
        _previousHabilidadeId = HabilidadeId;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Verifica se o modal foi ativado (false -> true)
        bool modalFoiAtivado = !_previousIsActive && IsActive;
        
        // Verifica se o HabilidadeId mudou
        bool idMudou = _previousHabilidadeId != HabilidadeId;

        // Recarrega se o modal foi ativado OU se o ID mudou
        if (modalFoiAtivado || idMudou)
        {
            await CarregarHabilidade();
        }

        // Atualiza os valores anteriores
        _previousIsActive = IsActive;
        _previousHabilidadeId = HabilidadeId;
    }
}