@namespace Preventech.Server.Components.Modals

@rendermode InteractiveServer

@inject HabilidadeSistemaService HabilidadeSistemaService

<Modal @bind-IsActive="IsActive">
    <MostrarMensagem @bind-Mensagem="mensagem" />
    <h3>Adicionar Habilidade do Sistema</h3>
    <EditForm Model="@novaHabilidade" OnValidSubmit="@AdicionarHabilidadeSistema">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="nome">Nome</label>
            <InputText id="nome" class="form-control" @bind-Value="@novaHabilidade.Nome" />
            <ValidationMessage For="@(() => novaHabilidade.Nome)" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@IsProcessing">Adicionar</button>
    </EditForm>

    <section class="info-section">
        <p>Essas habilidades do sistema definem quais possíveis habilidades os usuários podem ter.</p>
        <p>Adicione com base nas necessidades das manutenções.</p>
    </section>
</Modal>

@code {
    [Parameter]
    public bool IsActive { get; set; }

    [Parameter]
    public EventCallback OnHabilidadeAdicionada { get; set; }

    private HabilidadeSistema novaHabilidade = new HabilidadeSistema();

    public string mensagem = string.Empty;
    private bool IsProcessing { get; set; } = false;

    private async Task AdicionarHabilidadeSistema()
    {
        IsProcessing = true;
        ApiResponse<HabilidadeSistema> response = await HabilidadeSistemaService.AddHabilidadeSistemaAsync(novaHabilidade);
        if (response.Success)
        {
            mensagem = "Habilidade adicionada com sucesso!";
            novaHabilidade = new HabilidadeSistema(); // Reset form
            await OnHabilidadeAdicionada.InvokeAsync(null);
        }
        else
        {
            mensagem = response.Message;
            novaHabilidade = new HabilidadeSistema(); // Reset form
        }
        IsProcessing = false;
    }
}