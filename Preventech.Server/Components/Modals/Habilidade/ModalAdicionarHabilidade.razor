@namespace Preventech.Server.Components.Modals

@rendermode InteractiveServer

@inject HabilidadeService HabilidadeService
@inject HabilidadeSistemaService HabilidadeSistemaService
@inject UserClaimsHelper UserClaimsHelper

<Modal @bind-IsActive="IsActive">
    <MostrarMensagem @bind-Mensagem="mensagem" />
    <h3>Adicionar Habilidade</h3>
    <EditForm Model="@novaHabilidade" OnValidSubmit="@AdicionarHabilidade">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="categoria">Categoria</label>
            <InputSelect @bind-Value="@novaHabilidade!.Categoria!.Id" class="form-control">
                <option value="0">Selecionar categoria</option>
                @foreach (var hab in habilidadesSistema)
                {
                    <option value="@hab.Id">@hab.Nome</option>
                }
            </InputSelect>
        </div>

        <div class="form-group">
            <label for="descricao">Descrição</label>
            <InputText id="descricao" class="form-control" @bind-Value="@novaHabilidade.Descricao" />
            <ValidationMessage For="@(() => novaHabilidade.Descricao)" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@IsProcessing">Adicionar</button>
    </EditForm>

    <section class="info-section">
        <p>Essas habilidades definem quais capacidades específicas os usuários possuem.</p>
        <p>Adicione com base nas necessidades das manutenções.</p>
    </section>
</Modal>

@code {
    [Parameter]
    public bool IsActive { get; set; }

    [Parameter]
    public EventCallback OnHabilidadeAdicionada { get; set; }

    List<HabilidadeSistema> habilidadesSistema = new List<HabilidadeSistema>();

    private Habilidade novaHabilidade = new Habilidade();

    public string mensagem = string.Empty;
    private bool IsProcessing { get; set; } = false;
    private UserInfo UserInfo = null!;

    protected override async Task OnInitializedAsync()
    {
        UserInfo = await UserClaimsHelper.GetCurrentUserInfoAsync() ?? new UserInfo();
        InitializeNovaHabilidade();
        habilidadesSistema = (await HabilidadeSistemaService.GetAllHabilidadesAsync()).Data ?? new List<HabilidadeSistema>();
    }

    private void InitializeNovaHabilidade()
    {
        novaHabilidade = new Habilidade
        {
            Usuario = new Usuario 
            { 
                Id = UserInfo?.Id ?? 0,
                Cpf = UserInfo?.Cpf ?? string.Empty,
            },
            Categoria = new HabilidadeSistema 
            { 
                Id = 0,
                Nome = string.Empty
            },
            Descricao = string.Empty
        };
    }

    private async Task AdicionarHabilidade()
    {
        IsProcessing = true;
        if(novaHabilidade?.Categoria == null || novaHabilidade.Categoria.Id <= 0)
        {
            mensagem = "Por favor, selecione uma categoria válida.";
            IsProcessing = false;
            return;
        }

        try
        {
            ApiResponse<Habilidade> response = await HabilidadeService.AddHabilidadeAsync(novaHabilidade);
            
            if (response.Success)
            {
                mensagem = response.Message;
                InitializeNovaHabilidade(); // Reseta o formulário
                await OnHabilidadeAdicionada.InvokeAsync(null);
            }
            else
            {
                mensagem = response.Message;
            }
        }
        catch (Exception ex)
        {
            mensagem = $"Erro na requisição: {ex.Message}";
        }
        
        IsProcessing = false;
    }
}