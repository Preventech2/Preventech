@namespace Preventech.Server.Components.Modals

@rendermode InteractiveServer

@inject HabilidadeService HabilidadeService
@inject HabilidadeSistemaService HabilidadeSistemaService
@inject UserClaimsHelper UserClaimsHelper

<Modal IsActive="@IsActive" IsActiveChanged="@OnIsActiveChanged">
    <MostrarMensagem @bind-Mensagem="mensagem" />
    <h3>Editar Habilidade</h3>
    <EditForm class="edit-form" Model="@editarHabilidade" OnValidSubmit="@EditarHabilidade">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (editarHabilidade.Categoria != null)
        {
            <div class="form-group">
                <label for="categoria">Categoria</label>
                <InputSelect @bind-Value="@editarHabilidade.Categoria.Id" class="form-control">
                    <option value="0">Selecionar categoria</option>
                    @foreach (var hab in habilidadesSistema)
                    {
                        <option value="@hab.Id">@hab.Nome</option>
                    }
                </InputSelect>
            </div>
        }

        <div class="form-group">
            <label for="descricao">Descrição</label>
            <InputText id="descricao" class="form-control" @bind-Value="@editarHabilidade.Descricao" />
            <ValidationMessage For="@(() => editarHabilidade.Descricao)" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@IsProcessing">Adicionar</button>
    </EditForm>
</Modal>

@code {
    [Parameter]
    public bool IsActive { get; set; }

    [Parameter]
    public EventCallback<bool> IsActiveChanged { get; set; }

    [Parameter]
    public EventCallback OnHabilidadeEditada { get; set; }

    [Parameter]
    public int HabilidadeId { get; set; }

    [Parameter]
    public EventCallback<int> HabilidadeIdChanged { get; set; }

    List<HabilidadeSistema> habilidadesSistema = new List<HabilidadeSistema>();

    private Habilidade editarHabilidade = new Habilidade();

    public string mensagem = string.Empty;
    private bool IsProcessing { get; set; } = false;
    private UserInfo UserInfo = new UserInfo();

    protected override async Task OnInitializedAsync()
    {
        await CarregarHabilidade();
        UserInfo = await UserClaimsHelper.GetCurrentUserInfoAsync() ?? new UserInfo();
        habilidadesSistema = (await HabilidadeSistemaService.GetAllHabilidadesAsync()).Data ?? new List<HabilidadeSistema>();
    }

    private async Task CarregarHabilidade()
    {
        mensagem = string.Empty;
        ApiResponse<Habilidade> response = await HabilidadeService.GetHabilidadeByIdAsync(HabilidadeId);
        if (response.Success && response.Data != null)
        {
            editarHabilidade = response.Data;
        }
        else
        {
            mensagem = response.Message;
            editarHabilidade = new Habilidade();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Recarrega se o modal foi ativado
        if (IsActive)
        {
            await CarregarHabilidade();
        }
    }

    private async Task EditarHabilidade()
    {
        IsProcessing = true;
        if(editarHabilidade?.Categoria == null || editarHabilidade.Categoria.Id <= 0)
        {
            mensagem = "Por favor, selecione uma categoria válida.";
            IsProcessing = false;
            return;
        }

        try
        {
            ApiResponse<Habilidade> response = await HabilidadeService.EditHabilidadeAsync(editarHabilidade);
            
            if (response.Success)
            {
                mensagem = response.Message;
                await OnHabilidadeEditada.InvokeAsync(null);
            }
            else
            {
                mensagem = response.Message;
            }
        }
        catch (Exception ex)
        {
            mensagem = $"Erro na requisição: {ex.Message}";
        }
        
        IsProcessing = false;
    }

    // Informa ao componente pai a mudança do estado do Modal
    private async Task OnIsActiveChanged(bool isActive)
    {
        await CarregarHabilidade();
        IsActive = isActive;
        await IsActiveChanged.InvokeAsync(IsActive);
    }
}