@rendermode InteractiveServer

<main class="@(IsActive ? "modal-opened" : "modal-closed") no-select">
    <section class="modal-section no-select">
        <span class="modal-close no-select" @onclick="CloseModal"><div class="close-btn-icon" /></span>
        <div class="modal-content no-select">
            @ChildContent
        </div>
    </section>
</main>

@code {
    [Parameter]
    public bool IsActive { get; set; }

    [Parameter]
    public EventCallback<bool> IsActiveChanged { get; set; }

    @* Recebe um Edit form ou outros conteudos que podem ser colocados no Modal *@
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private async Task CloseModal()
    {
        Console.WriteLine("Modal - CloseModal chamado");
        IsActive = false;
        await IsActiveChanged.InvokeAsync(IsActive);
    }
}