@page "/cadastrar/peca"
@rendermode InteractiveServer
@inject IJSRuntime jSRuntime

<PageTitle>Cadastrar Peça</PageTitle>

<h2>Cadastrar Peça</h2>

<h1>Cadastrar Peça</h1>
@if (!string.IsNullOrEmpty(mensagemResultado))
{
    <div class="alert @(sucesso ? "alert-success" : "alert-danger")" role="alert">
        @mensagemResultado
    </div>
}

<EditForm Model="peca" OnValidSubmit="FormData" FormName="cadastrar-Peca">
    <DataAnnotationsValidator />
    <label>Nome:
        <InputText @bind-Value="peca!.Descricao" class="form-control"/>
    </label>
    <label>Quantidade:
        <InputNumber @bind-Value="peca!.Quantidade" class="form-control" />
    </label>
    <button type="submit" class="btn btn-primary" disabled="@isProcessing">
        @if (isProcessing)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <text>Cadastrando...</text>
        }
        else
        {
            <text>Cadastrar</text>
        }
    </button>
</EditForm>

@code
{
    [SupplyParameterFromForm]
    private Peca? peca { get; set; } = null;

    [Inject]
    PecaService pecaService { get; set; } = null!;

    private string mensagemResultado = string.Empty;
    private bool sucesso = false;
    private bool isProcessing = false;

    protected override void OnInitialized() => peca ??= new Peca();

    private async Task FormData()
    {
        isProcessing = true;
        StateHasChanged();
        try {
            ApiResponse<Peca>? resultado = await pecaService.AddPecaAsync(peca!);

            await jSRuntime.InvokeVoidAsync("console.log", resultado);
            if (resultado != null && resultado.Success)
            {
                mensagemResultado = resultado.Message;
                sucesso = true;
            }
            else
            {
                mensagemResultado = "Erro inesperado ao cadastrar peça.";
                sucesso = false;
            }
        }
        catch (Exception ex)
        {
            mensagemResultado = $"Erro: {ex.Message}";
            sucesso = false;
        }
        finally{
            isProcessing = false;
            StateHasChanged();
        }
    }
}