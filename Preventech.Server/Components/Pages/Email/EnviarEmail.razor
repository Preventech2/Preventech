@page "/enviar-email"
@rendermode InteractiveServer

<h3>EnviarEmail</h3>

<p>@message</p>
<InputText @bind-value="email" placeholder="Digite seu email"></InputText>
<button class="btn btn-primary" @onclick='SendEmail'>Enviar Email</button>

@code {
    public string message = string.Empty;
    private string email = string.Empty;

    [Inject]
    private EmailService emailService { get; set; } = null!;

    private void SendEmail()
    {
        message = "Enviando email...";
        message = emailService.SendEmail(email, "Bem-vindo ao Preventech", "Seu cadastro foi realizado com sucesso!");
    }
}
