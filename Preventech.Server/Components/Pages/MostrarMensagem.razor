@rendermode InteractiveServer

@if (!string.IsNullOrEmpty(Mensagem))
{
    <div class="alert alert-info" role="alert">
        @Mensagem
    </div>
}

@code {
    [Parameter]
    public string Mensagem { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> MensagemChanged { get; set; }
}
