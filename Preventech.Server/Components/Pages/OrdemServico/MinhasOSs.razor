@page "/ordens-servico/user"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.QuickGrid
@using Preventech.Core.DTOs
@using Preventech.Core.Services
@inject UserClaimsHelper UserClaimsHelper

<PageTitle>Visualizar Ordens de Servico</PageTitle>
 
@if (ordens == null)
{
    <p><em>Carregando...</em></p>
}
else if (!ordens.Any())
{
    <p><em>Você não é responsável por nenhuma ordem de serviço.</em></p>
}
else
{
    <h3>Lista de Ordens de Serviço</h3>
}

<QuickGrid Items="@ordens">
    <TemplateColumn Title="Status">
        <div>
            <img src="@GetStatusIcon(context.Status)" alt="Status Icon"
                 width="14" height="14" style="margin-right: 2px;" />
            @context.Status
        </div>
    </TemplateColumn>
    <PropertyColumn Property="@(item => item.Titulo)" Title="Título" />
    <PropertyColumn Property="@(item => item.Descricao)" Title="Descrição" />
    <PropertyColumn Property="@(item => item.Abertura)" Title="Abertura" />
    <PropertyColumn Title="Técnico Responsável" Property="@(item => item.TecnicoResponsavel != null ? item.TecnicoResponsavel.Nome : "(não atribuído)")" />
    <TemplateColumn Title="">
        <div>
            <button class="btn-icon" @onclick='@(() => NavigationManager.NavigateTo($"/ordens-servico/{@context.Id}"))'><img class="icon" src="img/more-icon.svg" alt="" /></button>
        </div>
    </TemplateColumn>
</QuickGrid>

@code {
    private IQueryable<OrdemServico> ordens = null!;
    private UserInfo? userInfo = null;

    [Inject]
    OrdemServicoService ordemService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        // Get current user info from claims
        userInfo = await UserClaimsHelper.GetCurrentUserInfoAsync();
        
        if (userInfo != null && userInfo.IsAuthenticated && userInfo.Id > 0)
        {
            // Use the existing method with the user ID from claims
            ApiResponse<List<OrdemServico>> response = await ordemService.GetOrdemServicoByResponsavelAsync(userInfo.Id);
            ordens = response.Data?.AsQueryable() ?? new List<OrdemServico>().AsQueryable();
        }
        else
        {
            ordens = new List<OrdemServico>().AsQueryable();
        }
    }
    @inject NavigationManager NavigationManager
    void VerDetalhes(OrdemServico ordem)
    {
    NavigationManager.NavigateTo($"/ordemservico/{ordem.Id}");
    }

    private string GetStatusIcon(StatusOS status)
    {
        return status switch
        {
            StatusOS.EmImpedimento => "img/em-impedimento.png",
            StatusOS.EmProgresso => "img/em-progresso.png",
            StatusOS.Concluida => "img/concluida.png",
            StatusOS.Parada => "img/parada.png",
            StatusOS.Deferida => "img/deferida.png",
            _ => ""
        };
    }
}