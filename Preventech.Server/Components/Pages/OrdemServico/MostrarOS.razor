@page "/ordens-servico"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.QuickGrid
@using Preventech.Core.DTOs

@inject NavigationManager NavigationManager

<HeaderTitle Title="Ordens de Serviço" />
 
@if (ordens == null)
{
    <p><em>Carregando...</em></p>
}
else if (!ordens.Any())
{
    <p><em>Nenhuma ordem de serviço cadastrada.</em></p>
}

<PageSection>
    <section class="header-section">
        <h4>Lista de Ordens de Serviço</h4>
        <button class="btn-icon" @onclick="@(() => NavigationManager.NavigateTo("/cadastrar/ordem-servico"))"><img class="icon" src="img/add-icon.svg" alt="" /></button>
    </section>
    <QuickGrid Items="@ordens">
        <TemplateColumn Title="Status">
            <div>
                <img src="@GetStatusIcon(context.Status)" alt="Status Icon"
                    width="14" height="14" style="margin-right: 2px;" />
                @context.Status
            </div>
        </TemplateColumn>
        <PropertyColumn Property="@(item => item.Titulo)" Title="Título" />
        <PropertyColumn Class="d-none d-md-table-cell" Property="@(item => item.Descricao)" Title="Descrição" />
        <PropertyColumn Property="@(item => item.Abertura)" Title="Abertura" />
        <PropertyColumn Class="d-none d-md-table-cell" Title="Técnico Responsável" Property="@(item => item.TecnicoResponsavel != null ? item.TecnicoResponsavel.Nome : "(não atribuído)")" />
        <TemplateColumn Title="">
            <div>
                <button class="btn-icon" @onclick='@(() => NavigationManager.NavigateTo($"/ordens-servico/{@context.Id}"))'><img class="icon" src="img/more-icon.svg" alt="" /></button>
            </div>
        </TemplateColumn>
    </QuickGrid>
</PageSection>

@code {
    private IQueryable<OrdemServico> ordens = null!;

    [Inject]
    OrdemServicoService ordemService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        ApiResponse<List<OrdemServico>> response = await ordemService.GetOrdemServicosAsync();
        ordens = response.Data?.AsQueryable() ?? new List<OrdemServico>().AsQueryable();
    }
    @inject NavigationManager NavigationManager
    void VerDetalhes(OrdemServico ordem)
    {
    NavigationManager.NavigateTo($"/ordemservico/{ordem.Id}");
    }

    private string GetStatusIcon(StatusOS status)
    {
        return status switch
        {
            StatusOS.EmImpedimento => "img/em-impedimento.png",
            StatusOS.EmProgresso => "img/em-progresso.png",
            StatusOS.Concluida => "img/concluida.png",
            StatusOS.Parada => "img/parada.png",
            StatusOS.Deferida => "img/deferida.png",
            _ => ""
        };
    }
}