@page "/cadastrar/ordem-servico"

@namespace Preventech.Server.Components.Pages

@attribute [Authorize(Roles = PerfilExtension.CriarOrdemDeServico)]

@rendermode InteractiveServer
@inject UserClaimsHelper UserClaimsHelper
@inject NavigationManager NavigationManager

<HeaderTitle Title="Ordem de Serviço" />

<MostrarMensagem @bind-Mensagem="mensagemResultado" />

<PageSection>
    <section class="header-section">
        <h4>Cadastrar OS</h4>
    </section>
    <EditForm class="edit-form" Model="ordemServico" OnSubmit="FormData" FormName="cadastrar-Ordem-Servico">
        <div class="form-group">
            <label for="titulo">Título</label>
            <InputText @bind-Value="ordemServico!.Titulo" class="form-control"/>
        </div>

        <div class="form-group">
            <label for="descricao">Descrição</label>
            <InputTextArea @bind-Value="ordemServico!.Descricao" class="form-control"/>
        </div>

        <div class="form-group">
            <label for="observacoes">Alguma observação?</label>
            <InputTextArea @bind-Value="ordemServico!.Observacoes" class="form-control"/>
        </div>

        <div class="form-group">
            <label for="documento">Deseja anexar um documento?</label>
            <InputFile OnChange="HandleFileSelection" multiple />
        </div>

        @if(equipamentos != null && equipamentos.Any()) 
        {
            <div class="mb-3">
                <label for="grupo">
                    Equipamento
                </label>
                <input type="text" class="form-control input-filter" placeholder="Digite n° de patrimônio ou nome..." @oninput="@((ChangeEventArgs e) => FilterEquipamentos(e.Value?.ToString()))" />
                <InputSelect @bind-Value="ordemServico!.EquipamentoId" class="form-control">
                    <option value="0">Selecionar equipamento</option>
                    @foreach (var equipamento in equipamentosFiltrados.Take(10))
                    {
                        <option value="@equipamento.Id">@equipamento.ToString()</option>
                    }
                </InputSelect>
            </div>
        }
        else
        {   
            <p><em>Carregando equipamentos</em></p>
            <span>Não encontrou o equipamento? <a href="/cadastrar/equipamento" target="_blank">Cadastre-o!</a></span>
        }
        <br />
        <button type="submit" class="btn btn-primary" disabled="@isProcessing">
            @if (isProcessing)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <text>Cadastrando...</text>
            }
            else
            {
                <text>Cadastrar</text>
            }
        </button>
    </EditForm>
</PageSection>

@code {
    [SupplyParameterFromForm]
    private OrdemServico? ordemServico { get; set; } = null;
    
    private IQueryable<Equipamento> equipamentos = null!;
    private IQueryable<Equipamento> equipamentosFiltrados = null!;

    [Inject]
    OrdemServicoService OSservice { get; set; } = null!;
    
    [Inject]
    EquipamentoService EquipService { get; set; } = null!;
    
    [Inject]
    DocumentoService DocService { get; set; } = null!;

    private List<IBrowserFile> arquivosParaUpload = new List<IBrowserFile>();
    private const long MAX_FILE_SIZE = 1024 * 1024 * 50; // 50MB

    private string mensagemResultado = string.Empty;
    private bool isProcessing = false;
    private UserInfo? userInfo = null;
    protected override async Task OnInitializedAsync()
    {
        userInfo = await UserClaimsHelper.GetCurrentUserInfoAsync();

        ordemServico = new OrdemServico();

        ApiResponse<List<Equipamento>> response = await EquipService.GetEquipamentos(Equipamento.Vazio);
        equipamentos = response.Data?.AsQueryable() ?? new List<Equipamento>().AsQueryable();
        equipamentosFiltrados = equipamentos;
    }
    
    private async Task FormData()
    {
        isProcessing = true;
        mensagemResultado = string.Empty;

        if (userInfo == null){
            isProcessing = false;
            
            mensagemResultado = "Erro de autenticação: Não foi possível identificar o usuário requisitante. Por favor, tente recarregar a página ou fazer login novamente.";
            return; // STOP the submission
        }

        if (ordemServico == null)
        {
            isProcessing = false;
            
            mensagemResultado = "Erro interno: Dados da ordem de serviço não foram inicializados corretamente.";
            return; // STOP the submission
        }

        if (ordemServico.EquipamentoId.HasValue == false || ordemServico.EquipamentoId == 0)
        {
            ordemServico.EquipamentoId = null;
        }

        ordemServico!.Abertura = DateTime.UtcNow;
        ordemServico!.Status = StatusOS.Parada;
        ordemServico!.TecnicoResponsavel = null;
        ordemServico!.RequisitanteId = userInfo.Id;
        
        Core.DTOs.ApiResponse<OrdemServico> response = await OSservice.AddOrdemServicoAsync(ordemServico) ?? new Core.DTOs.ApiResponse<OrdemServico>();
        mensagemResultado = response.Message;

        if (response.Success && response.Data != null)
        {
            Guid novaOrdemId = response.Data.Id;
            int arquivosComErro = 0;
            foreach (var file in arquivosParaUpload)
            {
                // ⭐ NOVO: Chama o serviço para enviar o arquivo ao endpoint 'api/documentos/upload/{ordemId}'
                Core.DTOs.ApiResponse<object> responseUpload = await DocService.UploadDocumentoAsync(novaOrdemId, file);

                if (!responseUpload.Success)
                {
                    arquivosComErro++;
                    // Acumula erros, mas continua tentando os outros arquivos
                    mensagemResultado += $"Erro ao fazer upload do arquivo {file.Name}: {responseUpload.Message}. ";
                }
            }
            
            // 4. Finalizar
            if (arquivosComErro == arquivosParaUpload.Count)
            {
                // Todos os uploads falharam
                mensagemResultado = $"Ordem de Serviço criada, mas NENHUM arquivo foi anexado. {mensagemResultado}";
            }

            else if (arquivosComErro > 0)
            {
                // A OS foi criada e alguns arquivos foram anexados, mas nem todos.
                mensagemResultado = $"Ordem de Serviço criada com sucesso. Alguns documentos falharam no upload ({arquivosComErro} de {arquivosParaUpload.Count}). Detalhes: {mensagemResultado}";
            }
            else
            {
                // Sucesso Total
                mensagemResultado = response.Message;
                ordemServico = new OrdemServico();
                arquivosParaUpload.Clear();
            }

            NavigationManager.NavigateTo($"/ordens-servico/{novaOrdemId}");
        }
        else
        {
            
            mensagemResultado = response.Message;
        }


        isProcessing = false;
    }

    private void HandleFileSelection(InputFileChangeEventArgs e) 
    {
        arquivosParaUpload.Clear(); // Limpa seleção anterior
        mensagemResultado = string.Empty;

        foreach (var file in e.GetMultipleFiles()) 
        {
            if (file.Size <= MAX_FILE_SIZE) 
            {
                // ⭐ MUDANÇA: Apenas armazena a referência do IBrowserFile.
                // O conteúdo real será lido durante o upload no DocService.
                arquivosParaUpload.Add(file);
            } 
            else 
            {
                mensagemResultado = $"O arquivo {file.Name} excede o tamanho máximo permitido de {MAX_FILE_SIZE / (1024 * 1024)} MB. Remova-o para continuar.";
                
                arquivosParaUpload.Clear(); // Opcional: Limpar tudo se houver um arquivo muito grande
                break;
            }
        }
        StateHasChanged(); // Força a atualização da UI para mostrar a lista de arquivos
    }

    public void FilterEquipamentos(string? filtro)
    {
        if (string.IsNullOrWhiteSpace(filtro))
        {
            equipamentosFiltrados = equipamentos;
        }
        else
        {
            equipamentosFiltrados = equipamentos.Where(e => e.Patrimonio.Contains(filtro) || e.Nome.Contains(filtro) || e.Nome.ToLower().Contains(filtro.ToLower()));
        }
    }
}