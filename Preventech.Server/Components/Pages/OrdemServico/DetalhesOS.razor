@page "/ordens-servico/{id:guid}"

@namespace Preventech.Server.Components.Pages

@attribute [Authorize(Roles = PerfilExtension.VisualizarOrdemDeServico)]

@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.QuickGrid
@using Preventech.Core.DTOs
@using Preventech.Core.Services
@using Preventech.Core.Templates
@inject UserClaimsHelper UserClaimsHelper
@inject NotificacaoSiteService notificacaoSiteService

<HeaderTitle Title="Ordem de Serviço" />
 
@if (ordem == null)
{
    <MostrarMensagem @bind-Mensagem="mensagemResultado" />
}
else
{
    <PageSection>
        <section class="header-section">
            <div class="d-flex align-items-center gap-2">
                <img src="@GetStatusIcon(@ordem.Status)" alt="Status Icon" width="20" height="20" />
                <h4 style="text-align: left;" class="mb-0">@ordem.Titulo</h4>
            </div>
            <div style="display: flex; flex-direction: row;">
                <a style="margin-right: 10px;" href="/ordens-servico/">Voltar</a>
                <span class="badge bg-secondary">@ordem.Status</span>
            </div>
        </section>

        <!-- Informações Principais -->
        <section class="border-bottom pb-3">
            <div class="row g-3">
                <div class="col-12">
                    <div class="alert alert-light mb-0" role="alert">
                        <i class="bi bi-calendar-event me-2"></i>
                        <strong>Aberta em:</strong> @ordem.Abertura.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">
                                <i class="bi bi-card-text me-2"></i>Descrição
                            </h6>
                            <p class="card-text">@(String.IsNullOrWhiteSpace(ordem.Descricao) ? "(Nenhuma descrição)" : ordem.Descricao)</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">
                                <i class="bi bi-chat-left-text me-2"></i>Observações
                            </h6>
                            <p class="card-text">@(String.IsNullOrWhiteSpace(ordem.Observacoes) ? "(Nenhuma observação)" : ordem.Observacoes)</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 p-3 bg-light rounded">
                        <i class="bi bi-gear text-primary"></i>
                        <div>
                            <small class="text-muted d-block">Equipamento</small>
                            <strong>@((String.IsNullOrWhiteSpace(equipamento.Nome)) ? "Não Atribuído" : equipamento.ToString())</strong>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 p-3 bg-light rounded">
                        <i class="bi bi-person text-primary"></i>
                        <div>
                            <small class="text-muted d-block">Requisitante</small>
                            <strong>
                                @if (ordem.Requisitante == null)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                }
                                else
                                {
                                    @ordem.Requisitante.Nome
                                }
                            </strong>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 p-3 bg-light rounded">
                        <i class="bi bi-hash text-primary"></i>
                        <div>
                            <small class="text-muted d-block">ID da OS</small>
                            <strong class="d-block" style="max-width: 200px;" title="@ordem.Id">@ordem.Id</strong>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Arquivos Anexados -->
        @if (ordem.Arquivos.Any())
        {
            <section class="border-bottom pb-3">
                <h5>
                    <i class="bi bi-paperclip me-2"></i>Arquivos Anexados
                </h5>
                <div class="list-group mt-3">
                    @foreach (var arquivo in ordem.Arquivos)
                    {
                        <a href="api/documentos/@arquivo.Id/download" target="_blank" download="@arquivo.NomeArquivo" 
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark-text text-primary"></i>
                                <div>
                                    <div class="fw-semibold">@arquivo.NomeArquivo</div>
                                    <small class="text-muted">@arquivo.DataEnvio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </div>
                            <i class="bi bi-download"></i>
                        </a>
                    }
                </div>
            </section>
        }

        <!-- Ações e Status do Técnico -->
        <section>
            @if (ordem.TecnicoResponsavel == null)
            {
                <AuthorizeView Roles="@PerfilExtension.EditarOrdemDeServico">
                    <Authorized Context="authContext">
                        <div class="alert alert-warning d-flex align-items-center gap-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                            <div class="flex-grow-1">
                                <h6 class="alert-heading mb-1">Ordem de Serviço Disponível</h6>
                                <p class="mb-0">Esta OS ainda não possui técnico responsável. Deseja assumir a responsabilidade?</p>
                            </div>
                        </div>
                        <EditForm Model="ordem" OnSubmit="FormData" FormName="pegar-Ordem-Servico">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm" disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Processando...</span>
                                }
                                else
                                {
                                    <span style="font-size: medium; font-weight: 600;">Pegar Ordem</span>
                                }
                            </button>
                        </EditForm>
                    </Authorized>
                </AuthorizeView>
            }
            else if (ordem.TecnicoResponsavel.Id == userInfo?.Id && ordem.Status != StatusOS.Concluida)
            {
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-tools me-2"></i>Ações do Técnico
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Upload de Documentos -->
                        <EditForm Model="ordem" OnSubmit="FormAddDoc" FormName="adicionar-documento" class="mb-4">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-cloud-upload me-2"></i>Anexar Documentos
                                </label>
                                <InputFile OnChange="HandleFileSelection" multiple class="form-control shadow-sm" />
                                
                                @if (arquivosParaUpload.Any())
                                {
                                    <div class="alert alert-info mt-3 mb-0">
                                        <h6 class="alert-heading">
                                            <i class="bi bi-file-earmark-check me-2"></i>Arquivos Selecionados:
                                        </h6>
                                        <ul class="mb-0">
                                            @foreach (var file in arquivosParaUpload)
                                            {
                                                <li>
                                                    <strong>@file.Name</strong> 
                                                    <span class="badge bg-secondary">@((file.Size / 1024).ToString("N0")) KB</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                            
                            <button type="submit" class="btn btn-success shadow-sm" disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Anexando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-upload me-2"></i>
                                    <span>Anexar Documentos</span>
                                }
                            </button>
                        </EditForm>

                        <!-- Botões de Ação -->
                        <div class="d-flex gap-2 flex-wrap">
                            @if (!isShowingCompletionForm)
                            {
                                <button type="button" class="btn btn-success shadow-sm" 
                                        @onclick="() => isShowingCompletionForm = true" 
                                        disabled="@isProcessing">
                                    <i class="bi bi-check-circle me-2"></i>
                                    Concluir OS
                                </button>
                            }

                            <EditForm Model="ordem" OnSubmit="FormDataCancel" FormName="cancelar-ordem" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger shadow-sm" disabled="@isProcessing">
                                    @if (isProcessing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Processando...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle me-2"></i>
                                        <span>Cancelar OS</span>
                                    }
                                </button>
                            </EditForm>
                        </div>
                    </div>
                </div>

                <!-- Formulário de Conclusão -->
                @if (isShowingCompletionForm)
                {
                    <EditForm Model="ordem" OnSubmit="FormDataFinish" FormName="form-conclusao">
                        <div class="card shadow border-success mb-3">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">
                                    <i class="bi bi-clipboard-check me-2"></i>Relatório de Conclusão
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label for="DescricaoSolucao" class="form-label fw-semibold">
                                        Descrição das Ações Realizadas: <span class="text-danger">*</span>
                                    </label>
                                    <InputTextArea id="DescricaoSolucao" 
                                                   @bind-Value="ordem.DescricaoSolucao" 
                                                   rows="6" 
                                                   class="form-control shadow-sm" 
                                                   placeholder="Descreva detalhadamente as ações realizadas para resolver a ordem de serviço..."
                                                   required />
                                    <ValidationMessage For="@(() => ordem.DescricaoSolucao)" class="text-danger" />
                                </div>

                                <div class="d-flex justify-content-between gap-2">
                                    <button type="button" class="btn btn-outline-secondary" 
                                            @onclick="() => isShowingCompletionForm = false">
                                        <i class="bi bi-arrow-left me-2"></i>Voltar
                                    </button>
                                    <button type="submit" class="btn btn-success shadow-sm" disabled="@isProcessing">
                                        @if (isProcessing)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <span>Finalizando...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check-lg me-2"></i>
                                            <span>Concluir e Salvar</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </div>
                    </EditForm>
                }
            }
            else if (ordem.Status == StatusOS.Concluida)
            {
                <div class="card shadow-sm border-success">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-check-circle-fill me-2"></i>Ordem de Serviço Concluída
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2 p-3 bg-light rounded">
                                    <i class="bi bi-person-check text-success"></i>
                                    <div>
                                        <small class="text-muted d-block">Técnico Responsável</small>
                                        <strong>@ordem.TecnicoResponsavel.Nome</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2 p-3 bg-light rounded">
                                    <i class="bi bi-calendar-check text-success"></i>
                                    <div>
                                        <small class="text-muted d-block">Data de Conclusão</small>
                                        <strong>@ordem.DataConclusão?.ToString("dd/MM/yyyy HH:mm")</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="card-subtitle mb-2 text-muted">
                                            <i class="bi bi-file-text me-2"></i>Descrição da Solução
                                        </h6>
                                        <p class="card-text mb-0">@ordem.DescricaoSolucao</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info d-flex align-items-center gap-3" role="alert">
                    <i class="bi bi-info-circle-fill fs-4"></i>
                    <div>
                        <h6 class="alert-heading mb-1">Técnico Atribuído</h6>
                        <p class="mb-0"><strong>@ordem.TecnicoResponsavel.Nome</strong> está responsável por esta ordem de serviço.</p>
                    </div>
                </div>
            }
        </section>
    </PageSection>
}

@code {
    private OrdemServico ordem = null!;
    private Equipamento equipamento = null!;
    private UserInfo? userInfo = null;
    private bool isShowingCompletionForm = false;

    [Parameter]
    public Guid id { get; set; }

    [Inject]
    OrdemServicoService ordemService { get; set; } = null!;
    
    [Inject]
    EquipamentoService EquipService { get; set; } = null!;

    [Inject]
    DocumentoService DocService { get; set; } = null!;

    [Inject]
    private EmailService emailService { get; set; } = null!;

    [Inject]
    private RelatorioGeneratorService RelatorioService { get; set; } = null!; 

    private List<IBrowserFile> arquivosParaUpload = new List<IBrowserFile>();
    private const long MAX_FILE_SIZE = 1024 * 1024 * 50; // 50MB

    private string mensagemResultado = string.Empty;
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        // Get current user info from claims
        userInfo = await UserClaimsHelper.GetCurrentUserInfoAsync();

        ApiResponse<OrdemServico>? response = await ordemService.GetOrdemServicoByIdAsync(id);

        if (response != null && response.Data != null)
        {
            ordem = response.Data;
        }

        else
        {
            ordem = new OrdemServico();
        }

        if (ordem.EquipamentoId.HasValue)
        {
            ApiResponse<List<Equipamento>> responseEquip = await EquipService.GetEquipamentos(new Equipamento{ Id = ordem.EquipamentoId.Value });

            if (responseEquip != null && responseEquip.Data != null && responseEquip.Data.Any())
            {
                equipamento = responseEquip.Data.FirstOrDefault()!;
            }
        }
        else
        {
            equipamento = Equipamento.Vazio;
        }
    }
    private string GetStatusIcon(StatusOS status)
    {
        return status switch
        {
            StatusOS.EmImpedimento => "img/status-os/em-impedimento.svg",
            StatusOS.EmProgresso => "img/status-os/em-progresso.svg",
            StatusOS.Concluida => "img/status-os/concluida.svg",
            StatusOS.Parada => "img/status-os/parada.svg",
            StatusOS.Deferida => "img/status-os/deferida.svg",
            _ => ""
        };
    }

    private async Task FormData()
    {
        if (userInfo == null || !userInfo.IsAuthenticated) return;

        // Create a Usuario object from userInfo for the API
        var usuario = new Usuario
        {
            Id = userInfo.Id,
            Nome = userInfo.Nome,
            Cpf = userInfo.Cpf
        };

        ordem.TecnicoResponsavel = usuario;
        ordem.TecnicoResponsavelId = usuario.Id; 
        ordem!.Status = StatusOS.EmProgresso;
        isProcessing = true;
        
        Core.DTOs.ApiResponse<OrdemServico> response = await ordemService.UpdateOrdemServicoAsync(ordem.Id, ordem) ?? new Core.DTOs.ApiResponse<OrdemServico>();
        mensagemResultado = response.Message;

        isProcessing = false;
            }

    private async Task FormDataCancel()
    {
        ordem.TecnicoResponsavel = null;
        ordem.TecnicoResponsavelId = null; 
        ordem!.Status = StatusOS.Parada;
        isProcessing = true;
        
        Core.DTOs.ApiResponse<OrdemServico> response = await ordemService.UpdateOrdemServicoAsync(ordem.Id, ordem) ?? new Core.DTOs.ApiResponse<OrdemServico>();
        mensagemResultado = response.Message;

        isProcessing = false;
            }

    private async Task FormDataFinish()
    {
        if (string.IsNullOrWhiteSpace(ordem.DescricaoSolucao))
        {
            // Isso será tratado pelo Blazor Validation, mas é bom como fallback.
            mensagemResultado = "A Descrição das Ações é obrigatória para a conclusão.";
            
            return;
        }

        ordem!.Status = StatusOS.Concluida;
        ordem!.DataConclusão = DateTime.UtcNow;

        isProcessing = true;
        
        Core.DTOs.ApiResponse<OrdemServico> response = await ordemService.UpdateOrdemServicoAsync(ordem.Id, ordem) ?? new Core.DTOs.ApiResponse<OrdemServico>();
        mensagemResultado = response.Message;

        byte[] relatorioBytes = RelatorioService.GerarRelatorioPDF(ordem); 
        string fileName = $"Relatorio_OS_{ordem.Id}.pdf";

        string message = "Enviando email...";
        
        if (ordem.Requisitante != null && ordem.Requisitante.Email != null) {
            message = "Enviando email para " + ordem.Requisitante.Nome;
            
            NotificacaoEmail notificacaoEmail = new NotificacaoEmail(
                titulo: NotificacaoTemplates.OrdemServico.TituloConcluida,
                mensagem: NotificacaoTemplates.OrdemServico.MensagemEmailConcluida(ordem),
                destinatario: ordem.Requisitante.Email
            );

            message = emailService.EnviarEmailComArquivo(notificacaoEmail, relatorioBytes, fileName);

            NotificacaoSite notificacaoSite = new NotificacaoSite(
                titulo: NotificacaoTemplates.OrdemServico.TituloConcluida,
                mensagem: NotificacaoTemplates.OrdemServico.MensagemSiteConcluida(ordem)
            );

            _ = notificacaoSiteService.EnviarNotificacaoAsync(notificacaoSite, ordem.Requisitante);

            mensagemResultado = "Notificamos o requisitante por email.";
        }

        else {
            message = "Não foi possível enviar o email, requisitante sem email cadastrado.";
        }

        isShowingCompletionForm = false;
        isProcessing = false;
            }

    private async Task FormAddDoc()
    {
        
        isProcessing = true;
        mensagemResultado = string.Empty;

        if (userInfo == null || !userInfo.IsAuthenticated)
        {
            isProcessing = false;
            mensagemResultado = "Erro de autenticação: Usuário não identificado.";
            return;
        }

        if (!arquivosParaUpload.Any())
        {
            isProcessing = false;
            mensagemResultado = "Nenhum arquivo selecionado para upload.";
            return;
        }

        Guid ordemId = ordem.Id;
        int arquivosComErro = 0;
        string errosAcumulados = string.Empty;

        foreach (var file in arquivosParaUpload)
        {
            Core.DTOs.ApiResponse<object> responseUpload = await DocService.UploadDocumentoAsync(ordemId, file);

            if (!responseUpload.Success)
            {
                arquivosComErro++;
                errosAcumulados += $"Erro ao fazer upload do arquivo {file.Name}: {responseUpload.Message}. ";
            }
        }

        if (arquivosComErro == 0)
        {
                        mensagemResultado = $"Todos os {arquivosParaUpload.Count} documentos anexados com sucesso!";
        }
        
        else if (arquivosComErro == arquivosParaUpload.Count)
        {
            
            mensagemResultado = $"NENHUM arquivo foi anexado. Detalhes: {errosAcumulados}";
        }
        
        else
        {
            // Parcialmente bem-sucedido
            mensagemResultado = $"Upload concluído. Alguns documentos falharam ({arquivosComErro} de {arquivosParaUpload.Count}). Detalhes: {errosAcumulados}";
        }

        // 3. Limpa a lista de arquivos temporários e recarrega a página para atualizar a lista de anexos
        arquivosParaUpload.Clear();
        await OnInitializedAsync();

        isProcessing = false;
    }

    private void HandleFileSelection(InputFileChangeEventArgs e) 
    {
        arquivosParaUpload.Clear(); // Limpa seleção anterior
        mensagemResultado = string.Empty;

        foreach (var file in e.GetMultipleFiles()) 
        {
            if (file.Size <= MAX_FILE_SIZE) 
            {
                // ⭐ MUDANÇA: Apenas armazena a referência do IBrowserFile.
                // O conteúdo real será lido durante o upload no DocService.
                arquivosParaUpload.Add(file);
            } 
            else 
            {
                mensagemResultado = $"O arquivo {file.Name} excede o tamanho máximo permitido de {MAX_FILE_SIZE / (1024 * 1024)} MB. Remova-o para continuar.";
                
                arquivosParaUpload.Clear(); // Opcional: Limpar tudo se houver um arquivo muito grande
                break;
            }
        }
        StateHasChanged(); // Força a atualização da UI para mostrar a lista de arquivos
    }
}