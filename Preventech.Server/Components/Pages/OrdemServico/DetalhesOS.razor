@page "/ordens-servico/{id:guid}"

@namespace Preventech.Server.Components.Pages

@attribute [Authorize(Roles = PerfilExtension.VisualizarOrdemDeServico)]

@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.QuickGrid
@using Preventech.Core.DTOs
@using Preventech.Core.Services
@using Preventech.Core.Templates
@inject UserClaimsHelper UserClaimsHelper
@inject NotificacaoSiteService notificacaoSiteService

<HeaderTitle Title="Ordem de Serviço" />
 
@if (ordem == null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <PageSection>
        <section class="header-section">
            <h4>@ordem.Titulo</h4>
        </section>
        <section>
        
            <div>
                <img src="@GetStatusIcon(@ordem.Status)" alt="Status Icon"
                    width="14" height="14" style="margin-right: 2px;" />
                @ordem.Status
                [Aberta em @ordem.Abertura]
            </div>
            <br>
            <p><strong>Descrição:</strong> @(String.IsNullOrWhiteSpace(ordem.Descricao) ? "(Nenhuma descrição)" : ordem.Descricao)</p>
            <p><strong>Observações:</strong> @(String.IsNullOrWhiteSpace(ordem.Observacoes) ? "(Nenhuma observação)" : ordem.Observacoes)</p>
            <p><strong>Id:</strong> @ordem.Id</p>
            <p><strong>Equipamento:</strong> @equipamento.ToString()</p>
            <p>
                <strong>Requisitado por: </strong> 
                    @if (ordem.Requisitante == null) {
                        <span> Carregando</span>
                    }

                    else {
                        @ordem.Requisitante.Nome
                    }
            </p>
            @foreach (var arquivo in @ordem.Arquivos)
            {
                <p>
                    <strong>Arquivo:</strong> 
                    <a href="api/documentos/@arquivo.Id/download" target="_blank" download="@arquivo.NomeArquivo">
                        @arquivo.NomeArquivo 
                        (@arquivo.DataEnvio.ToLocalTime()) </a>
                </p>
            }

            @if (ordem.TecnicoResponsavel == null) {
                <AuthorizeView Roles="@PerfilExtension.EditarOrdemDeServico">
                    <Authorized Context="authContext">
                    <EditForm Model="ordem" OnSubmit="FormData" FormName="pegar-Ordem-Servico">
                        <button type="submit" class="btn btn-primary" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span class="visually-hidden">Processando...</span>
                            }
                            else
                            {
                                <text>Pegar ordem</text>
                            }
                        </button>
                    </EditForm> 
                    </Authorized>
                </AuthorizeView>     
            }

            else if (ordem.TecnicoResponsavel.Id == userInfo?.Id && ordem.Status != StatusOS.Concluida) {
                <div>
                    <EditForm Model="ordem" OnSubmit="FormAddDoc" FormName="adicionar-documento">
                        <div class="mb-3">
                            <label>Deseja anexar documentos?
                                <InputFile OnChange="HandleFileSelection" multiple />
                            </label>
                            @if (arquivosParaUpload.Any())
                            {
                                <p class="mt-2">Arquivos selecionados para upload:</p>
                                <ul>
                                    @foreach (var file in arquivosParaUpload)
                                    {
                                        <li>@file.Name (@((file.Size / 1024).ToString("N0")) KB)</li>
                                    }
                                </ul>
                            }
                            
                            <button type="submit" class="btn btn-success" disabled="@isProcessing"> 
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <text>Anexando...</text>
                                }
                                else
                                {
                                    <text>Anexar documento</text>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
                <div>
                    <EditForm Model="ordem" OnSubmit="FormDataCancel" FormName="pegar-Ordem-Servico">
                        <button type="submit" class="btn btn-danger" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span class="visually-hidden">Processando...</span>
                            }
                            else
                            {
                                <text>Cancelar</text>
                            }
                        </button>
                    </EditForm>
                </div>
                @if (!isShowingCompletionForm)
                {
                    <div>
                        <button type="button" class="btn btn-success" @onclick="() => isShowingCompletionForm = true" disabled="@isProcessing">
                            Concluir OS (Detalhar Ações)
                        </button>
                    </div>
                }
                else {
                    <EditForm Model="ordem" OnSubmit="FormDataFinish" FormName="form-conclusao">
                        <div class="card my-3 p-3 border-success">
                            <h4>Relatório de Conclusão</h4>

                            <div class="mb-3">
                                <label for="DescricaoSolucao" class="form-label">Descrição das Ações Realizadas:</label>
                                <InputTextArea id="DescricaoSolucao" @bind-Value="ordem.DescricaoSolucao" rows="5" class="form-control" required />
                                <ValidationMessage For="@(() => ordem.DescricaoSolucao)" />
                            </div>

                            <div class="d-flex justify-content-between">
                                <button type="button" class="btn btn-secondary" @onclick="() => isShowingCompletionForm = false">
                                    Cancelar
                                </button>
                                <button type="submit" class="btn btn-success" disabled="@isProcessing">
                                    @if (isProcessing)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <text>Finalizando...</text>
                                    }
                                    else
                                    {
                                        <text>Concluir e Salvar</text>
                                    }
                                </button>
                            </div>
                        </div>
                    </EditForm>
                }
            }

            else if (ordem.Status == StatusOS.Concluida) {
                <p><strong>Técnico Responsável:</strong> @ordem.TecnicoResponsavel.Nome</p>
                <p><strong>Descrição da solução:</strong> @ordem.DescricaoSolucao</p>
                <p><strong>Data de Conclusão:</strong> @ordem.DataConclusão</p>
            }

            else {
                <p><strong>Técnico Responsável:</strong> @ordem.TecnicoResponsavel.Nome</p>
            }
        </section>
    </PageSection>
}

@code {
    private OrdemServico ordem = null!;
    private Equipamento equipamento = null!;
    private UserInfo? userInfo = null;
    private bool isShowingCompletionForm = false;

    [Parameter]
    public Guid id { get; set; }

    [Inject]
    OrdemServicoService ordemService { get; set; } = null!;
    
    [Inject]
    EquipamentoService EquipService { get; set; } = null!;

    [Inject]
    DocumentoService DocService { get; set; } = null!;

    [Inject]
    private EmailService emailService { get; set; } = null!;

    [Inject]
    private RelatorioGeneratorService RelatorioService { get; set; } = null!; 

    private List<IBrowserFile> arquivosParaUpload = new List<IBrowserFile>();
    private const long MAX_FILE_SIZE = 1024 * 1024 * 50; // 50MB

    private string mensagemResultado = string.Empty;
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        // Get current user info from claims
        userInfo = await UserClaimsHelper.GetCurrentUserInfoAsync();

        ApiResponse<OrdemServico>? response = await ordemService.GetOrdemServicoByIdAsync(id);

        if (response != null && response.Data != null)
        {
            ordem = response.Data;
        }

        else
        {
            ordem = new OrdemServico();
        }

        if (ordem.EquipamentoId.HasValue)
        {
            ApiResponse<List<Equipamento>> responseEquip = await EquipService.GetEquipamentos(new Equipamento{ Id = ordem.EquipamentoId.Value });

            if (responseEquip != null && responseEquip.Data != null && responseEquip.Data.Any())
            {
                equipamento = responseEquip.Data.FirstOrDefault()!;
            }
        }
        else
        {
            equipamento = new Equipamento
            {
                Nome = "Não atribuído",
                Patrimonio = "N/A"
            };
        }
    }
    private string GetStatusIcon(StatusOS status)
    {
        return status switch
        {
            StatusOS.EmImpedimento => "img/em-impedimento.png",
            StatusOS.Concluida => "img/concluida.png",
            StatusOS.EmProgresso => "img/em-progresso.png",
            StatusOS.Parada => "img/parada.png",
            StatusOS.Deferida => "img/deferida.png",
            _ => ""
        };
    }

    private async Task FormData()
    {
        if (userInfo == null || !userInfo.IsAuthenticated) return;

        // Create a Usuario object from userInfo for the API
        var usuario = new Usuario
        {
            Id = userInfo.Id,
            Nome = userInfo.Nome,
            Cpf = userInfo.Cpf
        };

        ordem.TecnicoResponsavel = usuario;
        ordem.TecnicoResponsavelId = usuario.Id; 
        ordem!.Status = StatusOS.EmProgresso;
        isProcessing = true;
        
        Core.DTOs.ApiResponse<OrdemServico> response = await ordemService.UpdateOrdemServicoAsync(ordem.Id, ordem) ?? new Core.DTOs.ApiResponse<OrdemServico>();
        mensagemResultado = response.Message;

        isProcessing = false;
            }

    private async Task FormDataCancel()
    {
        ordem.TecnicoResponsavel = null;
        ordem.TecnicoResponsavelId = null; 
        ordem!.Status = StatusOS.Parada;
        isProcessing = true;
        
        Core.DTOs.ApiResponse<OrdemServico> response = await ordemService.UpdateOrdemServicoAsync(ordem.Id, ordem) ?? new Core.DTOs.ApiResponse<OrdemServico>();
        mensagemResultado = response.Message;

        isProcessing = false;
            }

    private async Task FormDataFinish()
    {
        if (string.IsNullOrWhiteSpace(ordem.DescricaoSolucao))
        {
            // Isso será tratado pelo Blazor Validation, mas é bom como fallback.
            mensagemResultado = "A Descrição das Ações é obrigatória para a conclusão.";
            
            return;
        }

        ordem!.Status = StatusOS.Concluida;
        ordem!.DataConclusão = DateTime.UtcNow;

        isProcessing = true;
        
        Core.DTOs.ApiResponse<OrdemServico> response = await ordemService.UpdateOrdemServicoAsync(ordem.Id, ordem) ?? new Core.DTOs.ApiResponse<OrdemServico>();
        mensagemResultado = response.Message;

        byte[] relatorioBytes = RelatorioService.GerarRelatorioPDF(ordem); 
        string fileName = $"Relatorio_OS_{ordem.Id}.pdf";

        string message = "Enviando email...";
        
        if (ordem.Requisitante != null && ordem.Requisitante.Email != null) {
            message = "Enviando email para " + ordem.Requisitante.Nome;
            
            NotificacaoEmail notificacaoEmail = new NotificacaoEmail(
                titulo: NotificacaoTemplates.OrdemServico.TituloConcluida,
                mensagem: NotificacaoTemplates.OrdemServico.MensagemEmailConcluida(ordem),
                destinatario: ordem.Requisitante.Email
            );

            message = emailService.EnviarEmailComArquivo(notificacaoEmail, relatorioBytes, fileName);

            NotificacaoSite notificacaoSite = new NotificacaoSite(
                titulo: NotificacaoTemplates.OrdemServico.TituloConcluida,
                mensagem: NotificacaoTemplates.OrdemServico.MensagemSiteConcluida(ordem)
            );

            _ = notificacaoSiteService.EnviarNotificacaoAsync(notificacaoSite, ordem.Requisitante);

            mensagemResultado = "Notificamos o requisitante por email.";
        }

        else {
            message = "Não foi possível enviar o email, requisitante sem email cadastrado.";
        }

        isShowingCompletionForm = false;
        isProcessing = false;
            }

    private async Task FormAddDoc()
    {
        
        isProcessing = true;
        mensagemResultado = string.Empty;

        if (userInfo == null || !userInfo.IsAuthenticated)
        {
            isProcessing = false;
            mensagemResultado = "Erro de autenticação: Usuário não identificado.";
            return;
        }

        if (!arquivosParaUpload.Any())
        {
            isProcessing = false;
            mensagemResultado = "Nenhum arquivo selecionado para upload.";
            return;
        }

        Guid ordemId = ordem.Id;
        int arquivosComErro = 0;
        string errosAcumulados = string.Empty;

        foreach (var file in arquivosParaUpload)
        {
            Core.DTOs.ApiResponse<object> responseUpload = await DocService.UploadDocumentoAsync(ordemId, file);

            if (!responseUpload.Success)
            {
                arquivosComErro++;
                errosAcumulados += $"Erro ao fazer upload do arquivo {file.Name}: {responseUpload.Message}. ";
            }
        }

        if (arquivosComErro == 0)
        {
                        mensagemResultado = $"Todos os {arquivosParaUpload.Count} documentos anexados com sucesso!";
        }
        
        else if (arquivosComErro == arquivosParaUpload.Count)
        {
            
            mensagemResultado = $"NENHUM arquivo foi anexado. Detalhes: {errosAcumulados}";
        }
        
        else
        {
            // Parcialmente bem-sucedido
            mensagemResultado = $"Upload concluído. Alguns documentos falharam ({arquivosComErro} de {arquivosParaUpload.Count}). Detalhes: {errosAcumulados}";
        }

        // 3. Limpa a lista de arquivos temporários e recarrega a página para atualizar a lista de anexos
        arquivosParaUpload.Clear();
        await OnInitializedAsync();

        isProcessing = false;
    }

    private void HandleFileSelection(InputFileChangeEventArgs e) 
    {
        arquivosParaUpload.Clear(); // Limpa seleção anterior
        mensagemResultado = string.Empty;

        foreach (var file in e.GetMultipleFiles()) 
        {
            if (file.Size <= MAX_FILE_SIZE) 
            {
                // ⭐ MUDANÇA: Apenas armazena a referência do IBrowserFile.
                // O conteúdo real será lido durante o upload no DocService.
                arquivosParaUpload.Add(file);
            } 
            else 
            {
                mensagemResultado = $"O arquivo {file.Name} excede o tamanho máximo permitido de {MAX_FILE_SIZE / (1024 * 1024)} MB. Remova-o para continuar.";
                
                arquivosParaUpload.Clear(); // Opcional: Limpar tudo se houver um arquivo muito grande
                break;
            }
        }
        StateHasChanged(); // Força a atualização da UI para mostrar a lista de arquivos
    }
}