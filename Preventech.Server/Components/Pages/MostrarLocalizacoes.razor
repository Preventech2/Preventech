@page "/laboratorios"
@rendermode InteractiveServer

@attribute [Authorize(Roles = PerfilExtension.VisualizarLaboratorio)]

@using Microsoft.AspNetCore.Components.QuickGrid
@using Preventech.Core.DTOs
@inject ProtectedSessionStorage ProtectedSessionStore

@inject LocalizacaoService localizacoesService

<HeaderTitle Title="Laboratórios" />

<MostrarMensagem @bind-Mensagem="mensagem" />
<PageSection>
    <section class="header-section">
        <h4>Laboratórios</h4>
        <button class="btn-icon" @onclick="@(() => IsCadastrarActive = true)"><img class="icon" src="img/add-icon.svg" alt="" /></button>
    </section>
    <QuickGrid TGridItem="Localizacao" Items="@localizacoes">
        @* <PropertyColumn Sortable="true" Property="@(item => item.Id)" Title="ID" /> *@
        <PropertyColumn Sortable="true" Property="@(item => item.Apelido)" Title="Nome" />
        <PropertyColumn Sortable="true" Property="@(item => "C" + item.Campus)" Title="Campus" />
        <PropertyColumn Class="d-none d-md-table-cell" Property="@(item => "P" + item.Predio)" Title="Prédio" />
        <PropertyColumn Class="d-none d-md-table-cell" Property="@(item => item.Andar)" Title="Andar" />
        <PropertyColumn Property="@(item => item.Numero)" Title="Sala" />
        <PropertyColumn Property="@(item => item.Responsavel.Nome)" Title="Responsável" />
        <TemplateColumn Class="col-actions" Title="Ações">
            <button class="btn-icon" @onclick="() => AcionarEditar(context)"><img class="icon" src="img/edit-icon.svg" alt="" /></button>
        </TemplateColumn>
    </QuickGrid>
</PageSection>

<CadastrarLocalizacao @bind-IsActive="@IsCadastrarActive" />
<EditarLocalizacao @bind-IsActive="@IsEditarActive" @bind-Local="Local" />

@code {
    private bool IsCadastrarActive = false;
    private bool IsEditarActive = false;
    private IQueryable<Localizacao>? localizacoes = null;
    private string mensagem = string.Empty;
    private Localizacao? Local { get; set; } = Localizacao.Vazia;

    protected override async Task OnInitializedAsync()
    {
        var tempo = DateTime.UnixEpoch;
        var result = await ProtectedSessionStore.GetAsync<DateTime>("AtualizacaoLocal");   
        if (!result.Success) {
            await ProtectedSessionStore.SetAsync("AtualizacaoLocal", tempo);
        }

        var date = result.Success ? result.Value : tempo;
        var response = await localizacoesService.GetLocalizacoes(Localizacao.Vazia, tempo);
        if (!response.Success)
            mensagem = response.Message ?? string.Empty;
        
        await ProtectedSessionStore.SetAsync("AtualizacaoLocal", response.Timestamp);
        if (response.Data == null)
            localizacoes = await ProtectedSessionStore.GetAsync<List<Localizacao>>("Local");
        else {
            localizacoes = response.Data?.Select(x => LocalizacaoExtension.Descompactar(x, Localizacao.Vazia)).AsQueryable() ?? new List<Localizacao>().AsQueryable();
            
        }
    }

    private void AcionarEditar(Localizacao item)
    {
        Local = item;
        IsEditarActive = true;
    }
}