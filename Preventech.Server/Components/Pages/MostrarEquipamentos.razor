@page "/equipamentos"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.QuickGrid
@using Preventech.Core.DTOs
@inject EquipamentoService equipamentoService

@if (equipamentos == null)
{
    <p><em>Carregando...</em></p>
}
else if (!equipamentos.Any())
{
    <p><em>Nenhum equipamento cadastrado.</em></p>
}
else
{
    <h3>Lista de Equipamentos</h3>
}

<MostrarMensagem @bind-Mensagem="mensagem" />
<QuickGrid TGridItem="Equipamento" Items="@equipamentos">
    <PropertyColumn Sortable="true" Property="@(item => item.Id)" Title="ID" />
    <PropertyColumn Sortable="true" Property="@(item => item.Patrimonio)" Title="Patrimônio" />
    <PropertyColumn Sortable="true" Property="@(item => item.Nome)" Title="Nome" />
    <PropertyColumn Property="@(item => item.Local)" Title="Local" />
    <TemplateColumn Title="Editar">
        <button @onclick="@(() => AcionarEditar(context))">
            Editar?
        </button>
    </TemplateColumn>
</QuickGrid>

<button @onclick="@(() => IsCadastrarActive = true)">Cadastrar novo Equipamento</button>

<CadastrarEquipamento IsActive="@IsCadastrarActive" />
<EditarEquipamento IsActive="@IsEditarActive" @bind-equipamento="equipamento" />


@code {

    private Equipamento equipamento = Equipamento.Vazio;

    /// Todos os equipamentos que existem no sistema
    private IQueryable<Equipamento> equipamentos = (new List<Equipamento>()).AsQueryable();

    /// Define se o modal de cadastro foi selecionado
    bool IsCadastrarActive = false;

    /// Define se o modal de edição foi selecionado
    bool IsEditarActive = false;

    string mensagem = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        ApiResponse<List<Equipamento>> response = await equipamentoService.GetEquipamentosAsync();
        mensagem = response.Message ?? string.Empty;
        equipamentos = response.Data?.AsQueryable() ?? (new List<Equipamento>()).AsQueryable();
    }

    private async Task AcionarEditar(Equipamento item)
    {
        equipamento = item;
        IsEditarActive = true;
    }
}