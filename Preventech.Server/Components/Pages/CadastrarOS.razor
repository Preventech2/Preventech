@page "/cadastrar/ordem-servico"

<PageTitle>Cadastrar uma Ordem de Serviço</PageTitle>

<h2>Cadastrar OS</h2>

@if (!string.IsNullOrEmpty(mensagemResultado))
{
    <div class="alert @(sucesso ? "alert-success" : "alert-danger")" role="alert">
        @mensagemResultado
    </div>
}

<EditForm Model="ordemServico" OnSubmit="FormData" FormName="cadastrar-Ordem-Servico">
    <label>Título:
        <InputText @bind-Value="ordemServico!.Titulo" class="form-control"/>
    </label>
    <label>Descrição:
        <InputText @bind-Value="ordemServico!.Descricao" class="form-control"/>
    </label>
    <button type="submit" class="btn btn-primary" disabled="@isProcessing">
        @if (isProcessing)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <text>Cadastrando...</text>
        }
        else
        {
            <text>Cadastrar</text>
        }
    </button>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private OrdemServico? ordemServico { get; set; } = null;

    [Inject]
    OrdemServicoService OSservice { get; set; } = null!;

    private string mensagemResultado = string.Empty;
    private bool sucesso = false;
    private bool isProcessing = false;
    protected override void OnInitialized() => ordemServico ??= new OrdemServico();
    
    private async Task FormData()
    {
        isProcessing = true;
        mensagemResultado = string.Empty;
        ordemServico!.Abertura = DateTime.UtcNow;
        ordemServico!.Status = StatusOS.Parada;
        ordemServico!.TecnicoResponsavel = "Não atribuído";
        //ordemServico!.Requisitante = UsuarioLogado.NomeCompleto;
        
        Core.DTOs.ApiResponse<OrdemServico> response = await OSservice.AddOrdemServicoAsync(ordemServico) ?? new Core.DTOs.ApiResponse<OrdemServico>();
        mensagemResultado = response.Message;

        isProcessing = false;
        sucesso = true;
    }
}