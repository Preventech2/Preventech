@page "/admin/adicionar-perfis"

<h3>AdicionarPerfis</h3>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert alert-info" role="alert">
        @mensagem
    </div>
}

<EditForm Model="@usuario" OnValidSubmit="HandleValidSubmit" FormName="adicionar-perfis">
    <DataAnnotationsValidator />
    <AntiforgeryToken />
    <ValidationSummary />

    <div class="mb-3">
        <label for="cpf" class="form-label">CPF</label>
        <InputText id="cpf" class="form-control" @bind-Value="usuario.Cpf" />
    </div>
    <div class="mb-3">
        <label for="perfis" class="form-label">Perfis</label><br />
        @foreach (Perfil flag in Enum.GetValues<Perfil>())
        {
            if (flag != Perfil.NenhumaPermissao)
            {
                <PerfilCheckbox @bind-Grupo="usuario.Grupo" Flag="flag" />
            }
        }
    </div>
    <button type="submit" class="btn btn-primary">Convidar</button>
</EditForm>

@code {
    Usuario usuario = new Usuario();

    [Inject]
    private UsuarioService usuarioService { get; set; } = null!;

    private string mensagem = string.Empty;

    private async Task HandleValidSubmit()
    {
        // TODO: Implement the submission logic
        // ApiResponse<Usuario> response = await usuarioService.InviteUsuarioAsync(usuario);
        // mensagem = response.Message;
        await Task.CompletedTask;
    }
}
