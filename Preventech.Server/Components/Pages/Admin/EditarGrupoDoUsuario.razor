@page "/admin/editar-grupo-usuario"

@attribute [Authorize(Roles = PerfilExtension.Admin)]

@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.QuickGrid

@inject UsuarioService usuarioService
@inject GrupoPerfilService grupoPerfilService

<HeaderTitle Title="Gerenciar Grupos de Usuários" />

<MostrarMensagem @bind-Mensagem="@mensagem" />

<PageSection>
    @if (usuarios.Any())
    {
        <section class="header-section">
            <h4>Usuários do Sistema</h4>
        </section>
        <QuickGrid TGridItem="Usuario" Items="@(usuarios.OrderBy(u => u.Nome))">
            <PropertyColumn Property="@(item => item.Nome)" Title="Nome" />
            <PropertyColumn Property="@(item => item.Grupo != null ? item.Grupo.Nome : "Sem grupo")" Title="Grupo Atual" />
            <TemplateColumn Class="col-actions" Title="Ações" Context="item">
                <button class="btn-icon" @onclick="() => EditarUsuario(item.Id)"><img class="icon" src="img/edit-icon.svg" alt="" /></button>
            </TemplateColumn>
        </QuickGrid>
    }
    else
    {
        <div>
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <p><em>Carregando usuários...</em></p>
        </div>
    }
</PageSection>

<ModalEditarGrupoUsuario @bind-IsActive="@IsEditModalActive" @bind-UsuarioId="@UsuarioId" OnGrupoEditado="OnGrupoEditado" />

@code {
    private IQueryable<Usuario> usuarios = new List<Usuario>().AsQueryable();
    private bool IsEditModalActive { get; set; } = false;
    private int UsuarioId { get; set; } = 0;
    private string mensagem = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CarregarUsuarios();
    }

    private async Task CarregarUsuarios()
    {
        ApiResponse<List<Usuario>> response = await usuarioService.GetUsuariosAsync();
        if (response.Success && response.Data != null)
        {
            usuarios = response.Data.AsQueryable();
        }
        else
        {
            mensagem = response.Message;
        }
    }

    public void EditarUsuario(int id)
    {
        if (id <= 0) return;

        UsuarioId = id;
        IsEditModalActive = true;
    }

    private async Task OnGrupoEditado()
    {
        IsEditModalActive = false;
        await CarregarUsuarios();
    }
}
