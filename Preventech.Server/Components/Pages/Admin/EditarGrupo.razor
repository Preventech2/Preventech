@page "/admin/editar-grupo/{GroupName}"

@rendermode InteractiveServer

@inject GrupoPerfilService grupoPerfilService
@inject NavigationManager navigationManager

<h3>Editar Grupo</h3>

<MostrarMensagem @bind-Mensagem="@mensagem" />

@if (sended)
{
    <section>
        <button @onclick="() => sended = false">Editar novamente</button>
        <button @onclick='() => navigationManager.NavigateTo("")'>Voltar</button>
    </section>
}
else
{
    <GrupoEditForm @bind-Grupo="@grupoPerfil" 
                    NeedNameInput="false" 
                    ButtonText="Salvar Alterações"
                    OnValidSubmit="HandleValidSubmit" />
}

@code {
    [Parameter]
    public string GroupName { get; set; } = string.Empty;

    private string mensagem = string.Empty;

    private GrupoPerfil grupoPerfil = new GrupoPerfil();

    private bool sended = false;

    private async Task HandleValidSubmit()
    {
        ApiResponse<GrupoPerfil>? response = await grupoPerfilService.EditGrupoPerfilAsync(grupoPerfil);
        if (response != null && response.Success)
        {
            sended = true;
        }
        mensagem = response?.Message ?? string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        ApiResponse<GrupoPerfil> response = await grupoPerfilService.GetGrupoPerfilByNameAsync(GroupName);
        if (response.Success && response.Data != null)
        {
            grupoPerfil = response.Data;
        }
    }
}
