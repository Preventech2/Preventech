@page "/admin/editar-grupo-usuario"

@rendermode InteractiveServer

<h3>Editar Grupo do Usuário</h3>

<MostrarMensagem @bind-Mensagem="@mensagem" />

@if (!userSelected)
{
    <EditForm Model="@usuario" OnValidSubmit="BuscarUsuario">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="cpf" class="form-label">Cpf</label>
            <CpfInput id="cpf" @bind-Cpf="usuario.Cpf" />
        </div>
        <button type="submit" class="btn btn-primary" disabled="@isProcessing">
            @if (isProcessing)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            }
            else
            {
                <text>Selecionar usuário</text>
            }
        </button>
    </EditForm>
}
else
{
    <EditForm Model="@usuario" OnValidSubmit="EditarGrupo">
        <AntiforgeryToken />
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="cpf" class="form-label">Cpf</label>
            <h6 id="cpf">@FormatCpf(usuario.Cpf)</h6>
        </div>
        
        <SelecionarGrupo @bind-Grupo="usuario.Grupo" />

        <button type="submit" class="btn btn-primary" disabled="@isProcessing">
            @if (isProcessing)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            }
            else
            {
                <text>Mudar grupo</text>
            }
        </button>
        <button type="button" class="btn btn-secondary" disabled="@isProcessing" @onclick="Cancelar">
            <text>Cancelar</text>
        </button>
    </EditForm>
}

@code {
    [Inject]
    private UsuarioService usuarioService { get; set; } = null!;

    [Inject]
    private GrupoPerfilService grupoPerfilService { get; set; } = null!;

    Usuario usuario = new Usuario();
    private List<GrupoPerfil> gruposPerfis = new List<GrupoPerfil>();
    private bool userSelected = false;
    private string mensagem = string.Empty;
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        ApiResponse<List<GrupoPerfil>> response = await grupoPerfilService.GetGruposPerfisAsync();
        if (response.Success && response.Data != null)
        {
            gruposPerfis = response.Data;
        }
    }

    private async Task BuscarUsuario()
    {   
        ApiResponse<Usuario> response = await usuarioService.GetUsuarioByCpfAsync(usuario);
        if (response.Success && response.Data != null)
        {
            usuario = response.Data;
            userSelected = true;
            mensagem = string.Empty;
        }
        else
        {
            mensagem = response.Message;
            userSelected = false;
            usuario = new Usuario();
        }
    }

    private async Task EditarGrupo()
    {
        Console.WriteLine("Começando a editar grupo");
        ApiResponse<Usuario> response = await usuarioService.AddGrupoInUsuarioAsync(usuario);
        if (response.Success)
        {
            mensagem = response.Message;
            userSelected = false;
            usuario = new Usuario();
        }
        else
        {
            mensagem = response.Message;
        }
        Console.WriteLine($"retornado: {response.Message}");
    }

    private void Cancelar()
    {
        userSelected = false;
        usuario = new Usuario();
        mensagem = string.Empty;
    }

    private string FormatCpf(string? cpf)
    {   
        if (string.IsNullOrEmpty(cpf))
            return string.Empty;
        cpf = cpf.Insert(3, ".");
        cpf = cpf.Insert(7, ".");
        cpf = cpf.Insert(11, "-");
        return cpf;
    }
}
