@using Microsoft.AspNetCore.Mvc.ModelBinding

@rendermode InteractiveServer

<EditForm Model="@Grupo" OnValidSubmit="OnValidSubmitHandler" FormName="grupo-edit-form">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (NeedNameInput) 
    {
        <div class="mb-3">
            <label for="nome" class="form-label">Nome do Grupo</label>
            <InputText id="nome" class="form-control" @bind-Value="Grupo.Nome" />
        </div>
    } 
    else 
    {
        <div class="mb-3">
            <label for="nome" class="form-label">Nome do Grupo</label>
            <h6 id="nome">@Grupo.Nome</h6>
        </div>
    }
    
    <div class="mb-3">
        <label for="descricao" class="form-label">Permissões</label>
        <PerfilCheckbox @bind-grupoPerfil="Grupo" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@isProcessing">
    @if (isProcessing)
    {
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
    }
    else
    {
        @ButtonText
    }
    </button>
</EditForm>

@code {
    // bind value de grupoPerfil
    [Parameter, EditorRequired]
    public GrupoPerfil Grupo { get; set; } = new GrupoPerfil();

    [Parameter, EditorRequired]
    public EventCallback<GrupoPerfil> GrupoChanged { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public bool NeedNameInput { get; set; } = true;

    [Parameter]
    public string ButtonText { get; set; } = "Enviar";

    private bool isProcessing = false;

    private async Task OnValidSubmitHandler()
    {
        isProcessing = true;
        
        try
        {
            await GrupoChanged.InvokeAsync(Grupo);
            await OnValidSubmit.InvokeAsync();
        }
        finally
        {
            isProcessing = false;
        }
    }

    protected override void OnInitialized()
    {
        if (Grupo.Permissoes == null)
        {
            Grupo.Permissoes = Perfil.NenhumaPermissao;
        }
    }
}
