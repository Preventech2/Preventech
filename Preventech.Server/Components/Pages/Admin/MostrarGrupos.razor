@page "/admin/grupos"

@rendermode InteractiveServer

@inject GrupoPerfilService grupoPerfilService
@inject NavigationManager navigationManager

<HeaderTitle Title="Grupos" />

<PageSection>
    @if (gruposPerfis.Any()) 
    {
        <section class="header-section">
            <h4>Grupos</h4>
            <button class="btn-icon" @onclick="AdicionarGrupo"><img class="icon" src="img/add-icon.svg" alt="" /></button>
        </section>
        <QuickGrid TGridItem="GrupoPerfil" Items="@gruposPerfis" Context="item">
            <PropertyColumn Property="@(item => item.Nome)" Title="Nome do Grupo" />
            <PropertyColumn Property="@(item => PerfilExtension.ToBeautifulString(item.Permissoes ?? Perfil.NenhumaPermissao))" Title="Permissões" />
            <TemplateColumn Class="col-actions" Title="Ações" Context="item">
                <button class="btn-icon" @onclick="() => EditarGrupo(item.Id)"><img class="icon" src="img/edit-icon.svg" alt="" /></button>
            </TemplateColumn>
        </QuickGrid>
    } 
</PageSection>

<ModalEditarGrupo @bind-IsActive="@IsEditModalActive" @bind-GrupoId="@GrupoId" OnGrupoEditado="OnGrupoEditadoHandler" />
<ModalAdicionarGrupo @bind-IsActive="@IsAddModalActive" OnGrupoAdicionado="OnGrupoAdicionadoHandler" />

@code {
    private bool IsAddModalActive { get; set; } = false;
    private bool IsEditModalActive { get; set; } = false;
    private int GrupoId { get; set; } = 0;

    IQueryable<GrupoPerfil> gruposPerfis = new List<GrupoPerfil>().AsQueryable();

    private async Task CarregarGruposPerfis()
    {
        Console.WriteLine("Carregando grupos de perfis...");
        ApiResponse<List<GrupoPerfil>> response = await grupoPerfilService.GetGruposPerfisAsync();
        gruposPerfis = response.Data?.AsQueryable() ?? new List<GrupoPerfil>().AsQueryable();
    }

    protected override async Task OnInitializedAsync()
    {
        await CarregarGruposPerfis();
    }

    public void EditarGrupo(int id)
    {
        Console.WriteLine($"EditarGrupo chamado com ID: {id} e IsAddModalActive: {IsAddModalActive}");
        if (id <= 0 || IsAddModalActive)
            return;

        GrupoId = id;
        IsEditModalActive = true;
    }

    public void AdicionarGrupo()
    {
        Console.WriteLine($"AdicionarGrupo chamado com IsEditModalActive: {IsEditModalActive}");
        if (IsEditModalActive)
            return;

        @* GrupoId = 0; *@
        IsAddModalActive = true;
    }

    private async Task OnGrupoEditadoHandler()
    {
        Console.WriteLine("Grupo editado com sucesso.");
        IsEditModalActive = false;
        await CarregarGruposPerfis();
    }

    private async Task OnGrupoAdicionadoHandler()
    {
        Console.WriteLine("Grupo adicionado com sucesso.");
        IsAddModalActive = false;
        await CarregarGruposPerfis();
    }
}
