<div class="mb-3">
    @foreach (Perfil perfil in perfis)
    {
        <div class="form-check">
            <input type="checkbox" 
                class="form-check-input" 
                id="perfil-@((int)perfil)"
                checked="@IsPermissionSet(perfil)"
                @onchange="@((ChangeEventArgs e) => TogglePermission(perfil, (bool)e.Value!))" />
            <label class="form-check-label" for="perfil-@((int)perfil)">
                @GetPermissionDisplayName(perfil)
            </label>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public GrupoPerfil Grupo { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventCallback<GrupoPerfil> GrupoChanged { get; set; }

    public List<Perfil> perfis { get; set; } = new List<Perfil>();

    protected override void OnInitialized()
    {
        // Filtra apenas as permissões individuais (exclui combinações como All, Admin, etc.)
        perfis = Enum.GetValues<Perfil>()
            .Where(p => p != Perfil.NenhumaPermissao && 
                       p != Perfil.All)
            .ToList();

        if(Grupo.Permissoes == null)
        {
            Grupo.Permissoes = Perfil.NenhumaPermissao;
        }
    }

    private bool IsPermissionSet(Perfil perfil)
    {
        return (Grupo.Permissoes & perfil) == perfil;
    }

    private async Task TogglePermission(Perfil perfil, bool isChecked)
    {
        if (isChecked)
        {
            // Adiciona a permissão (OR bitwise)
            Grupo.Permissoes |= perfil;
        }
        else
        {
            // Remove a permissão (AND com NOT bitwise)
            Grupo.Permissoes &= ~perfil;
        }

        // Notifica o componente pai sobre a mudança
        await GrupoChanged.InvokeAsync(Grupo);
    }

    private string GetPermissionDisplayName(Perfil perfil)
    {
        string name = perfil.ToString();
        // Adiciona espaços antes de letras maiúsculas (exceto a primeira letra)
        return System.Text.RegularExpressions.Regex.Replace(name, "(\\B[A-Z])", " $1");
    }
}
