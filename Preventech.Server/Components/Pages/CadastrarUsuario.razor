@page "/cadastrar/usuario"
@using Preventech.Core.DTOs

@rendermode InteractiveServer

<h1>Cadastrar Usuário</h1>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert alert-info" role="alert">
        @mensagem
    </div>
}

<EditForm Model="usuario" OnValidSubmit="OnSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="cpf" class="form-label">Cpf</label>
        <InputText id="cpf" type="text" class="form-control" maxlength="14" @bind-Value="viewCpf" @oninput="FormatCpf" />
    </div>
    <div class="mb-3">
        <label for="nome" class="form-label">Nome</label>
        <InputText id="nome" type="text" class="form-control" @bind-Value="usuario.Nome" />
    </div>
    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <InputText id="email" type="email" class="form-control" @bind-Value="usuario.Email" />
    </div>
    <div class="mb-3">
        <label for="senha" class="form-label">Senha</label>
        <InputText id="senha" type="password" class="form-control" @bind-Value="usuario.Senha" />
    </div>
    <button type="submit" class="btn btn-primary">Cadastrar</button>

    @code {
        private string viewCpf = string.Empty;
        private Usuario usuario = new Usuario();

        [Inject]
        private UsuarioService usuarioService { get; set; } = null!;

        private string mensagem = string.Empty;

        private void FormatCpf(ChangeEventArgs e)
        {
            string digits = new string(e.Value?.ToString()?.Where(char.IsDigit).ToArray() ?? Array.Empty<char>());
            
            if (digits.Length > 11) {
                digits = digits.Substring(0, 11);
                Console.WriteLine("CPF com 11 dígitos atingido:" + digits);
            }

            usuario.Cpf = digits;
            
            if (digits.Length >= 4)
                digits = digits.Insert(3, ".");
            if (digits.Length >= 8)
                digits = digits.Insert(7, ".");
            if (digits.Length >= 12)
                digits = digits.Insert(11, "-");

            viewCpf = digits;
        }

        public async Task OnSubmit()
        {
            ApiResponse<Usuario> response = await usuarioService.AddUsuarioAsync(usuario) ?? new ApiResponse<Usuario>();
            mensagem = response.Message;
        }
    }
</EditForm>