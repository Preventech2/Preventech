@page "/meu-perfil"

@attribute [Authorize]

@rendermode InteractiveServer

<HeaderTitle Title="Meu Perfil" />

<PageSection>
    <EditFormUser />
</PageSection>

<PageSection>
    <section class="header-section">
        <h4>Habilidades</h4>
        <button class="btn-icon" @onclick="AdicionarHabilidade"><img class="icon" src="img/add-icon.svg" alt="" /></button>
    </section>
    <section class="body-section">
        <GridHabilidades EditarHabilidade="@EditarHabilidade" @bind-NeedUpdate="GridHabilidadesNeedUpdate" />
    </section>
</PageSection>

<ModalAdicionarHabilidade @bind-IsActive="@IsAddModalActive" OnHabilidadeAdicionada="OnHabilidadeAdicionada" />
<ModalEditarHabilidade @bind-IsActive="@IsEditModalActive" @bind-HabilidadeId="@habilidadeEdicaoId" OnHabilidadeEditada="OnHabilidadeEditada" />

@code {
    private bool IsAddModalActive { get; set; } = false;
    private bool IsEditModalActive { get; set; } = false;
    private int habilidadeEdicaoId { get; set; } = 0;
    private bool GridHabilidadesNeedUpdate { get; set; } = false;

    public void EditarHabilidade(int id)
    {
        if (id <= 0 || IsAddModalActive) return;

        habilidadeEdicaoId = id;
        IsEditModalActive = true;
    }

    public async Task OnHabilidadeEditada()
    {
        IsEditModalActive = false;
        UpdateGrid();
    }

    public void AdicionarHabilidade(MouseEventArgs e)
    {
        if (IsEditModalActive) return;

        IsAddModalActive = true;
    }

    public async Task OnHabilidadeAdicionada()
    {
        IsAddModalActive = false;
        UpdateGrid();
    }

    protected override async Task OnInitializedAsync()
    {
        UpdateGrid();
    }

    public void UpdateGrid()
    {
        GridHabilidadesNeedUpdate = true;
        StateHasChanged();
    }
}
