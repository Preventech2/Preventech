@page "/signup"
@using Preventech.Core.DTOs
@using Preventech.Core.Templates

@rendermode InteractiveServer

@inject NavigationManager navigationManager
@inject AuthService authService
@inject UsuarioService usuarioService
@inject EmailService emailService
@inject NotificacaoSiteService notificacaoSiteService

<h3>Cadastro</h3>

<MostrarMensagem @bind-Mensagem="mensagem" />

<PageSection>
    <EditForm class="edit-form" Model="usuario" OnValidSubmit="OnSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="cpf" class="form-label">Cpf</label>
            <CpfInput id="cpf" @bind-Cpf="usuario.Cpf" />
        </div>
        <div class="mb-3">
            <label for="nome" class="form-label">Nome</label>
            <InputText id="nome" type="text" class="form-control" @bind-Value="usuario.Nome" />
        </div>
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" type="email" class="form-control" @bind-Value="usuario.Email" />
        </div>
        <div class="mb-3">
            <label for="senha" class="form-label">Senha</label>
            <InputText id="senha" type="password" class="form-control" @bind-Value="usuario.Senha" />
        </div>
        <button type="submit" class="btn btn-primary" disabled="@isProcessing">
            @if (isProcessing)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            }
            else
            {
                <text>Cadastrar</text>
            }
        </button>
    </EditForm>
</PageSection>

@code {
    [SupplyParameterFromForm]
    public Usuario usuario { get; set; } = new Usuario();

    private string viewCpf = string.Empty;
    private bool isProcessing = false;

    private string mensagem = string.Empty;

    public async Task OnSubmit()
    {
        isProcessing = true;
        
        // Checa se todos os campos foram preenchidos
        if (string.IsNullOrWhiteSpace(usuario.Cpf) ||
            string.IsNullOrWhiteSpace(usuario.Nome) ||
            string.IsNullOrWhiteSpace(usuario.Email) ||
            string.IsNullOrWhiteSpace(usuario.Senha))
        {
            mensagem = "Por favor, preencha todos os campos.";
            isProcessing = false;
            return;
        }

        ApiResponse<Usuario> response = await usuarioService.AddUsuarioAsync(usuario) ?? new ApiResponse<Usuario>();
        mensagem = response.Message;

        if (response.Success && response.Data != null)
        {
            mensagem = "Usuário cadastrado com sucesso!";

            response = await usuarioService.LoginUsuarioAsync(response.Data);
            if (response.Success && response.Data != null)
            {
                usuario = response.Data;
                await SendNotificacoes();
                await authService.Login(response.Data);
                navigationManager.NavigateTo("/");
            }
            else
            {
                mensagem = response.Message ?? "Erro ao fazer login.";
                usuario = new Usuario(); // Limpa os campos
            }
        }
        else
        {
            mensagem = response.Message ?? "Erro ao cadastrar usuário.";
        }

        usuario = new Usuario();
        isProcessing = false;
    }

    public async Task SendNotificacoes()
    {
        UserInfo userInfo = new();
        userInfo.Nome = usuario.Nome!;

        NotificacaoEmail notificacaoEmail = new NotificacaoEmail(
            titulo: NotificacaoTemplates.BoasVindas.Titulo,
            mensagem: NotificacaoTemplates.BoasVindas.MensagemEmail(userInfo.DisplayName()),
            destinatario: usuario.Email!);

        emailService.EnviarEmail(notificacaoEmail);

        NotificacaoSite notificacaoSite = new NotificacaoSite(
            titulo: NotificacaoTemplates.BoasVindas.Titulo,
            mensagem: NotificacaoTemplates.BoasVindas.MensagemSite(userInfo.DisplayName()));

        await notificacaoSiteService.EnviarNotificacaoAsync(notificacaoSite, usuario);
    }
}