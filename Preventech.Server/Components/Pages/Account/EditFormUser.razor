@rendermode InteractiveServer

@inject UserClaimsHelper UserClaimsHelper
@inject UsuarioService UsuarioService
@inject AuthService AuthService

@if (IsAuthenticated)
{
    <MostrarMensagem @bind-Mensagem="mensagem" />
    <EditForm Model="usuario" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="cpf" class="form-label">CPF</label>
            <CpfInput id="cpf" @bind-Cpf="usuario.Cpf" Disabled="true" />
        </div>
        <div class="mb-3">
            <label for="nome" class="form-label">Nome</label>
            <InputText id="nome" class="form-control" @bind-Value="usuario.Nome" Disabled="@IsDisabled" />
        </div>
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" class="form-control" @bind-Value="usuario.Email" Disabled="@IsDisabled" />
        </div>
        <div class="mb-3">
            <label for="grupo" class="form-label">Grupo</label>
            <InputText id="grupo" class="form-control" @bind-Value="usuario.Grupo!.Nome" Disabled="true" />
        </div>
        <button type="button" class="btn btn-secondary me-2" @onclick="EditarCancelar">
            @(IsDisabled ? "Editar" : "Cancelar")
        </button>
        <button type="submit" class="btn btn-primary" disabled="@IsDisabled">Salvar</button>
    </EditForm>
}
else
{
    <p><em>Carregando informações do usuário...</em></p>
}

@code {
    private Usuario usuario = new Usuario();
    private bool IsAuthenticated = false;
    private bool IsDisabled = true;
    private string mensagem = string.Empty;
    private UserInfo UserInfo = new UserInfo();

    protected override async Task OnInitializedAsync()
    {
        UserInfo = await UserClaimsHelper.GetCurrentUserInfoAsync();
        usuario = UserInfo.GetUsuario();
        IsAuthenticated = UserInfo.IsAuthenticated;
    }
    
    private void EditarCancelar()
    {
        Console.WriteLine("toggled!");
        IsDisabled = !IsDisabled;
        if (IsDisabled)
        {
            usuario = UserInfo.GetUsuario();
            IsAuthenticated = UserInfo.IsAuthenticated;
        }
    }

    private async Task HandleValidSubmit()
    {
        ApiResponse<Usuario> response = await UsuarioService.UpdateUsuarioAsync(usuario);
        if (response.Success && response.Data != null)
        {
            bool isLoggedIn = await AuthService.Login(response.Data);
            UserInfo = await UserClaimsHelper.GetCurrentUserInfoAsync() ?? new UserInfo();
            usuario = UserInfo.GetUsuario();
            IsAuthenticated = UserInfo.IsAuthenticated;
            IsDisabled = true;
        }
        else
        {
            mensagem = response.Message;
        }
    }
}
