@using Microsoft.AspNetCore.Components.QuickGrid
@using Preventech.Core.Models

@rendermode InteractiveServer

@inject HabilidadeService HabilidadeService

<QuickGrid Items="@habilidades.AsQueryable()" TGridItem="Habilidade">
    <PropertyColumn Title="Categoria" Property="@(item => item.Categoria!.Nome)" />
    <PropertyColumn Title="Descricao" Property="@(item => item.Descricao)" />
    <TemplateColumn Title="Ações" Context="item">
        <button @onclick="() => EditarHabilidade(item.Id)">Editar</button>
        <button @onclick="() => RemoverHabilidade(item.Id)">Remover</button>
    </TemplateColumn>
</QuickGrid>

@code {
    [Parameter]
    public bool NeedUpdate { get; set; } = false;

    private List<Habilidade> habilidades = new List<Habilidade>();

    protected override async Task OnInitializedAsync()
    {
        await LoadHabilidades();
    }

    private async Task LoadHabilidades()
    {
        ApiResponse<List<Habilidade>> response = await HabilidadeService.GetAllHabilidadesAsync();
        if (response.Success && response.Data != null)
        {
            habilidades = response.Data;
        }
        else
        {
            habilidades = new List<Habilidade>();
        }
    }

    private void EditarHabilidade(int id)
    {
        // TODO: Implement edit logic here, e.g., navigate to edit page or open a dialog
    }

    private async Task RemoverHabilidade(int id)
    {
        // TODO: Implement remove logic here, e.g., call service to remove and reload list
    }

    protected override async Task OnParametersSetAsync()
    {
        if (NeedUpdate)
        {
            await LoadHabilidades();
            NeedUpdate = false; // Reset the flag after updating
        }
    }
}
