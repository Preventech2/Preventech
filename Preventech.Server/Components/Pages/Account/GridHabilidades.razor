        new Habilidade { Categoria = new HabilidadeSistema { Nome = "Categoria 3" }, Descricao = "Descrição 3" }
    };
    
    private void AdicionarHabilidade(MouseEventArgs args)
    {
        throw new NotImplementedException();
    }
