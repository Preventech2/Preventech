@page "/login"
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Preventech.Core.DTOs

@rendermode InteractiveServer

@inject NavigationManager navigationManager

<h3>Login</h3>

<MostrarMensagem @bind-Mensagem="@mensagem" />

<EditForm Model="@usuario" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="cpf" class="form-label">CPF</label>
        <CpfInput id="cpf" @bind-Cpf="usuario.Cpf" />
    </div>
    <div class="mb-3">
        <label for="senha" class="form-label">Senha</label>
        <InputText id="senha" type="password" class="form-control" @bind-Value="usuario.Senha" />
    </div>
    <button type="submit" class="btn btn-primary">Entrar</button>
    <p><a href="/signup">Não tem uma conta? Cadastre-se</a></p>
</EditForm>

@code {
    private Usuario usuario = new Usuario();

    [Inject]
    private UsuarioService usuarioService { get; set; } = null!;

    [Inject]
    private AuthService authService { get; set; } = null!;

    private string mensagem = string.Empty;
    private string viewCpf = string.Empty;

    private async Task HandleValidSubmit()
    {
        ApiResponse<Usuario> response = await usuarioService.LoginUsuarioAsync(usuario);
        if (response.Success && response.Data != null)
        {
            Console.WriteLine($"Usuario pertence ao grupo: {response.Data.Grupo?.Nome}");
            await authService.Login(response.Data);
        }
        else
        {
            mensagem = response.Message ?? "Erro ao fazer login.";
            usuario = new Usuario(); // Limpa os campos
        } 
    }
}