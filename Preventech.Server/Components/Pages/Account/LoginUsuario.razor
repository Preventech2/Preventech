@page "/login"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Preventech.Core.DTOs
@rendermode InteractiveServer

@inject AuthenticationStateService authStateService
@inject NavigationManager navigationManager

<h3>Login</h3>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert alert-info" role="alert">
        @mensagem
    </div>
}

<EditForm Model="@usuario" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="cpf" class="form-label">CPF</label>
        <InputText id="cpf" class="form-control" @bind-Value="usuario.Cpf" />
    </div>
    <div class="mb-3">
        <label for="senha" class="form-label">Senha</label>
        <InputText id="senha" type="password" class="form-control" @bind-Value="usuario.Senha" />
    </div>
    <button type="submit" class="btn btn-primary">Entrar</button>
</EditForm>

@code {
    private Usuario usuario = new Usuario();

    [Inject]
    private UsuarioService usuarioService { get; set; } = null!;

    private string mensagem = string.Empty;

    private async Task HandleValidSubmit()
    {
        ApiResponse<Usuario> response = await usuarioService.LoginUsuarioAsync(usuario);
        mensagem = response.Message;

        if(response.Success && response.Data != null)
        {
            await authStateService.MarkUserAsAuthenticated(response.Data);
            navigationManager.NavigateTo("/", true);
        }
    }
}