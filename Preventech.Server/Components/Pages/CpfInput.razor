<InputText id="@id" type="text" class="form-control" maxlength="14" @bind-Value="CpfView" @oninput="FormatCpf" />

@code {
    [Parameter]
    public string id { get; set; } = String.Empty;

    [Parameter, EditorRequired]
    public string Cpf { get; set; } = String.Empty;

    [Parameter, EditorRequired]
    public EventCallback<string> CpfChanged { get; set; }

    private string CpfView = String.Empty;

    private void FormatCpf(ChangeEventArgs e)
    {
        string digits = new string(e.Value?.ToString()?.Where(char.IsDigit).ToArray() ?? Array.Empty<char>());
        
        if (digits.Length > 11) {
            digits = digits.Substring(0, 11);
            Console.WriteLine("CPF com 11 dígitos atingido:" + digits);
        }

        // change the bound Cpf value
        Cpf = digits;
        CpfChanged.InvokeAsync(Cpf);
        
        if (digits.Length >= 4)
            digits = digits.Insert(3, ".");
        if (digits.Length >= 8)
            digits = digits.Insert(7, ".");
        if (digits.Length >= 12)
            digits = digits.Insert(11, "-");

        // update the view value
        CpfView = digits;
    }
}