@page "/localizacao/editar"
@rendermode InteractiveServer
@inject IJSRuntime jsr

<PageTitle>Editar uma localização</PageTitle>

<h1>Editar localização </h1>
@if (!string.IsNullOrEmpty(mensagemResultado))
{
    <div class="alert @(sucesso ? "alert-success" : "alert-danger")" role="alert">
    @mensagemResultado
</div>
}

<h2 data-tooltip="filtra localizações para edição">Filtro de localizações</h2>

<EditForm Model="filtro" OnSubmit="AtualizarFiltro" FormName="gerar-filtro">
    <label data-tooltip="Nome dado à um local, caso aplicável. Exemplos: 'LABFUND' ou 'DGO'">Nome (opcional):
        <InputText @bind-Value="filtro!.Apelido" class="form-control" />
    </label>
    <label data-tooltip="Número do campus que esta localização se refere">Campus:
        <InputNumber @bind-Value="filtro!.Campus" class="form-control" />
    </label>
    <label data-tooltip="Número do prédio desta localização">Prédio:
        <InputNumber @bind-Value="filtro!.Predio" class="form-control" />
    </label>
    <label data-tooltip="Número do andar desta localização">Andar:
        <InputNumber @bind-Value="filtro!.Andar" class="form-control" />
    </label>
    <label data-tooltip="Número da sala">Sala:
        <InputNumber @bind-Value="filtro!.Numero" class="form-control" />
    </label>
    <button type="submit" class="btn btn-primary" disabled="@isProcessing">
        @if (isProcessing)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <text>Filtrando...</text>
        }
        else
        {
            <text>Filtrar</text>
        }
    </button>
</EditForm>
<br>


@if (locais.Any())
{
    <form>
    <div class="mb-3">
        <label>Localização:
            <select @onchange="SelecionarFiltro">
                @foreach (var local in locais)
                    {
                        <option value="@local!.Id">@local.ToString()</option>
                    }
                </select>
            </label>
            <span>Não encontrou o local? <a href="/localizacao/cadastrar">Cadastre-o!</a></span>
        </div>
    </form>
}
else
{
    <p><em>Locais não selecionados</em></p>
    
}

@if (local != null) {
<EditForm Model="local" OnSubmit="EditarLoc" FormName="atualizar-local">
    <label data-tooltip="Nome dado à um local, caso aplicável. Exemplos: 'LABFUND' ou 'DGO'">Nome (opcional):
        <InputText @bind-Value="local!.Apelido" class="form-control" />
    </label>
    <label data-tooltip="Número do campus que esta localização se refere">Campus:
        <InputNumber @bind-Value="local!.Campus" class="form-control" />
    </label>
    <label data-tooltip="Número do prédio desta localização">Prédio:
        <InputNumber @bind-Value="local!.Predio" class="form-control" />
    </label>
    <label data-tooltip="Número do andar desta localização">Andar:
        <InputNumber @bind-Value="local!.Andar" class="form-control" />
    </label>
    <label data-tooltip="Número da sala">Sala:
        <InputNumber @bind-Value="local!.Numero" class="form-control" />
    </label>
    <button type="submit" class="btn btn-primary" disabled="@isProcessingLoc">
        @if (isProcessingLoc)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <text>Editar...</text>
        }
        else
        {
            <text>Editar</text>
        }
    </button>
</EditForm>
}


@code {
    [SupplyParameterFromForm]
    private Localizacao? filtro { get; set; } = null;

    [SupplyParameterFromForm]
    private Localizacao? local { get; set; } = null;

    [Inject]
    LocalizacaoService localizacaoService { get; set; } = null!;

    private List<Localizacao> locais = new();

    private int? localid;

    private string mensagemResultado = string.Empty;
    private bool sucesso = false;
    private bool isProcessing = false;
    private bool isProcessingLoc = false;

    protected override void OnInitialized()
    {
        filtro ??= new Localizacao();
    }

    private async Task AtualizarFiltro()
    {
        isProcessing = true;
        mensagemResultado = string.Empty;
        StateHasChanged();

        try
        {
            var res = await localizacaoService.GetLocalizacoes(filtro!);
            if (!res.Success)
            {
                await jsr.InvokeVoidAsync("console.log", res.Message);
                mensagemResultado = res.Message;
                sucesso = false;
            }
            else
            {
                locais = res.Data;
            }
        }
        catch (Exception ex)
        {
            mensagemResultado = $"Erro: {ex.Message}";
            sucesso = false;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void SelecionarFiltro(ChangeEventArgs e)
    {
        var res = int.Parse(e.Value.ToString());
        local = (from loc in locais where loc.Id == res select loc).First();
        StateHasChanged();
    }

    private async Task EditarLoc()
    {
        isProcessingLoc = true;
        mensagemResultado = string.Empty;
        StateHasChanged();

        try
        {
            var res = await localizacaoService.EditarLocalizacaoAsync(local);
            if (!res.Success)
            {
                await jsr.InvokeVoidAsync("console.log", res.Message);
                mensagemResultado = res.Message;
                sucesso = false;
            }
            else
            {
                local = null;
                filtro = new Localizacao();
            }
        }
        catch (Exception ex)
        {
            mensagemResultado = $"Erro: {ex.Message}";
            sucesso = false;
        }
        finally
        {
            isProcessingLoc = false;
            StateHasChanged();
        }
    }



}