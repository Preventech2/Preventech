@page "/localizacao/cadastrar"
@rendermode InteractiveServer
@inject IJSRuntime jsr

<PageTitle>Cadastrar uma localização</PageTitle>

@if (!string.IsNullOrEmpty(mensagemResultado))
{
    <div class="alert @(sucesso ? "alert-success" : "alert-danger")" role="alert">
    @mensagemResultado
</div>
}
<EditForm style="@(aberto ? "" : "display: none")" Model="local" FormName="cadastrar-Localizacoes">
    <button class="fecha-form" @onclick="@(e => aberto = false)">x</button>
    <h2>Cadastrar locald1ização</h2>
    <br>
    <p><em>*</em> indica item obrigatório</p>
    <div>
        <label data-tooltip="Nome dado à um local, caso aplicável. Exemplos: 'LABFUND' ou 'DGO'">Nome:</label>
        <InputText @bind-Value="local!.Apelido" class="form-control" />
    </div>
    <div>
        <label data-tooltip="Número do campus que esta localização se refere"><em>*</em>Campus:</label>
        <InputNumber @bind-Value="local!.Campus" class="form-control" required />
    </div> 
    <div>
        <label data-tooltip="Número do prédio desta localização"><em>*</em>Prédio:</label>
        <InputNumber @bind-Value="local!.Predio" class="form-control" required />
    </div>
    <div>
        <label data-tooltip="Número do andar desta localização"><em>*</em>Andar:</label>
        <InputNumber @bind-Value="local!.Andar" class="form-control" required />
    </div>
    <div>
        <label data-tooltip="Número da sala"><em>*</em>Sala:</label>
        <InputNumber @bind-Value="local!.Numero" class="form-control" required />
    </div>
    <button @onclick="SubmitLoc" class="btn btn-primary" disabled="@isProcessing">
        @if (isProcessing)
        {
            <text>Cadastrando...</text>
        }
        else
        {
            <text>Cadastrar</text>
        }
    </button>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private Localizacao? local { get; set; } = null;

    [Inject]
    LocalizacaoService localizacaoService { get; set; } = null!;

    bool aberto = true;

    private string mensagemResultado = string.Empty;
    private bool sucesso = false;
    private bool isProcessing = false;
    protected override void OnInitialized() => local ??= new Localizacao();

    private async Task SubmitLoc()
    {
        isProcessing = true;
        mensagemResultado = string.Empty;
        StateHasChanged();
        try
        {
            var resultado = await localizacaoService.AddLocalizacaoAsync(local!);

            sucesso = resultado != null && resultado.Success;
            if (sucesso)
            {
                mensagemResultado = resultado.Message;
            }
            else
            {
                await jsr.InvokeVoidAsync("console.log", resultado);
                mensagemResultado = "Erro inesperado ao cadastrar localização.";
            }
        }
        catch (Exception ex)
        {
            mensagemResultado = $"Erro: {ex.Message}";
            sucesso = false;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
}