    <NotAuthorized>
        <p>Você não está logado. Por favor, faça login para acessar mais funcionalidades.</p>
    </NotAuthorized>
</AuthorizeView>

<p>
    <AuthorizeView Roles="VisualizarEquipamento">
        <Authorized>
            <!-- Conteúdo permitido -->
            Top Secret
        </Authorized>
