@page "/"
@rendermode InteractiveServer

@using Preventech.Server.Components.Modals

@attribute [Authorize]

@inject NavigationManager navigationManager
@inject NotificacaoSiteService notificacaoSiteService
@inject UserClaimsHelper userClaimsHelper

<HeaderTitle Title="Home" />

<h1>Bem vindo ao Preventech!</h1>

<AuthorizeView Roles="@PerfilExtension.EditarOrdemDeServico">
    <Authorized>
        <PageSection>
            <section class="header-section">
                <h4>Tarefas pendentes</h4>
            </section>
        </PageSection>
    </Authorized>
</AuthorizeView>

<PageSection>
    <section class="notificacoes-section">
        Titulo: <InputText @bind-Value="titulo"></InputText><br/>
        Mensagem: <InputText @bind-Value="mensagem"></InputText>
        <button @onclick="sendMensagem">Enviar</button>
        <h4>Notificações</h4>
        <QuickGrid Items="nsus.AsQueryable()" TGridItem="NotificacaoSiteUsuario">
            <PropertyColumn Property="@(x => x.Notificacao.Titulo)" Title="Título" Sortable="true" />
            <PropertyColumn Property="@(x => x.Notificacao.Mensagem)" Title="Mensagem" Sortable="true" />
            <PropertyColumn Property="@(x => x.Notificacao.DataPublicacao)" Title="Data de Publicação" Sortable="true" Format="g" />
        </QuickGrid>
    </section>
</PageSection>

<AuthorizeView Roles="@PerfilExtension.VisualizarLaboratorio">
    <Authorized>
        <PageSection>
            <section class="header-section">
                <h4>Dashboard Laboratórios</h4>
            </section>
        </PageSection>
    </Authorized>
</AuthorizeView>

@code
{
    private string titulo = string.Empty;
    private string mensagem = string.Empty;
    UserInfo userInfo = new UserInfo();
    public List<NotificacaoSiteUsuario> nsus = new List<NotificacaoSiteUsuario>();
    
    protected override async Task OnInitializedAsync()
    {
        userInfo = await userClaimsHelper.GetCurrentUserInfoAsync();
    }

    public async Task sendMensagem()
    {
        NotificacaoSite notificacao = new NotificacaoSite
        {
            Titulo = titulo,
            Mensagem = mensagem,
        };

        ApiResponse<List<NotificacaoSiteUsuario>> api = await notificacaoSiteService.GetNotificacoesAsync(userInfo.GetUsuario());
        nsus = api.Data!;
        @* ApiResponse<bool> response = await notificacaoSiteService.ApagarNotificacaoAsync(); *@
    }
}