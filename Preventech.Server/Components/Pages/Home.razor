@page "/"
@rendermode InteractiveServer

@using Preventech.Server.Components.Modals

@attribute [Authorize]

@inject NavigationManager navigationManager

<HeaderTitle Title="Home" />

<h1>Bem vindo ao Preventech!</h1>

<AuthorizeView>
    <Authorized>
        <p>Você está logado.</p>
        <ul>
            <li><a href="/localizacao/cadastrar">Cadastrar localizacao</a></li>
            <li><a href="/cadastrar/equipamento">Cadastrar Equipamento</a></li>
            <li><a href="/equipamentos">Equipamentos</a></li>
            <li><a href="/cadastrar/usuario">Cadastrar Usuário</a></li>
            <li><a href="/cadastrar/ordem-servico">Cadastrar Ordem de Serviço</a></li>
            <li><a href="/ordens-servico">Visualizar Ordens de Serviço</a></li>
        </ul>
    </Authorized>
    <NotAuthorized>
        <p>Você não está logado. Por favor, faça login para acessar mais funcionalidades.</p>
    </NotAuthorized>
</AuthorizeView>

<AuthorizeView Roles="@PerfilExtension.VisualizarLaboratorio">
    <Authorized>
        <PageSection>
            <h5>Laboratórios</h5>
            <button @onclick="OpenModal">Adicionar</button>
            <Modal @bind-IsActive="isModalActive">
                <h6>Conteúdo do Modal</h6>
                <button @onclick="CloseModal">Cancelar</button>
                <button>Confirmar</button>
            </Modal>

            <Preventech.Server.Components.Pages.Account.GridHabilidades />
        </PageSection>
    </Authorized>
</AuthorizeView>

@code {
    private bool isModalActive = false;

    private void OpenModal()
    {
        isModalActive = true;
    }

    private void CloseModal()
    {
        isModalActive = false;
    }
}