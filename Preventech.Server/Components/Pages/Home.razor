@page "/"

@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Bem vindo ao Preventech!</h1>

<AuthorizeView>
    <Authorized>
        <p>Você está logado.</p>
        <ul>
            <li><a href="/cadastrar/localizacao">Cadastrar localizacao</a></li>
            <li><a href="/cadastrar/equipamento">Cadastrar Equipamento</a></li>
            <li><a href="/equipamentos">Equipamentos</a></li>
            <li><a href="/cadastrar/usuario">Cadastrar Usuário</a></li>
            <li><a href="/usuarios">Usuários</a></li>
            <li><a href="/cadastrar/ordem-servico">Cadastrar Ordem de Serviço</a></li>
            <li><a href="/ordens-servico">Visualizar Ordens de Serviço</a></li>
            <li><a href="/enviar-email">Enviar Email</a></li>
        </ul>
